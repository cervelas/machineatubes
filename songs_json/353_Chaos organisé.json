te": 40, "duration": 4}, {"beat": 208, "note": 39, "duration": 4}, {"beat": 212, "note": 37, "duration": 4}, {"beat": 216, "note": 36, "duration": 4}, {"beat": 220, "note": 40, "duration": 4}, {"beat": 224, "note": 39, "duration": 4}, {"beat": 228, "note": 37, "duration": 4}, {"beat": 232, "note": 36, "duration": 4}, {"beat": 236, "note": 40, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 91, "duration": 4}, {"beat": 96, "note": 91, "duration": 4}, {"beat": 176, "note": 91, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 100, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Le matin je me l\u00e8ve, tout est en d\u00e9sordre"}, {"beat": 44, "text": "Les chaussettes m\u00e9lang\u00e9es, j'en rigole encore"}, {"beat": 52, "text": "Les cl\u00e9s de la voiture, introuvables comme toujours"}, {"beat": 60, "text": "Mais dans ce chaos, je trouve toujours le bon parcours"}, {"beat": 68, "text": "Dans ma vie c'est le chaos organis\u00e9"}, {"beat": 76, "text": "Je suis bord\u00e9lique, \u00e7a me met enjou\u00e9"}, {"beat": 84, "text": "Les affaires s'empilent, c'est un vrai capharna\u00fcm"}, {"beat": 92, "text": "Mais je trouve toujours tout, je ne suis pas un p'tit c**!"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Sur mon bureau, les feuilles sont \u00e9parpill\u00e9es"}, {"beat": 124, "text": "Mais je sais exactement o\u00f9 est chaque id\u00e9e"}, {"beat": 132, "text": "Quand je cr\u00e9e, c'est un v\u00e9ritable foutoir"}, {"beat": 140, "text": "Mais \u00e7a me permet de trouver l'inspiration chaque soir"}, {"beat": 148, "text": "Je suis un perfectionniste \u00e0 ma mani\u00e8re"}, {"beat": 156, "text": "M\u00eame si tout est en vrac, je vois clair"}, {"beat": 164, "text": "Mes amis me disent de faire le m\u00e9nage de temps en temps"}, {"beat": 172, "text": "Mais j'aime voir ma vie comme un art d\u00e9ment"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors je continuerai d'\u00eatre d\u00e9sordonn\u00e9"}, {"beat": 220, "text": "Un artiste fou, jamais apprivois\u00e9"}, {"beat": 228, "text": "Car dans ce chaos, je trouve ma libert\u00e9"}, {"beat": 236, "text": "Et c'est dans le bazar que je suis vraiment combl\u00e9!"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}