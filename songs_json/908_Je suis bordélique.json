tion": 4}, {"beat": 220, "note": 26, "duration": 4}, {"beat": 224, "note": 24, "duration": 4}, {"beat": 228, "note": 29, "duration": 4}, {"beat": 232, "note": 28, "duration": 4}, {"beat": 236, "note": 26, "duration": 4}]}, "toplines": {"type": "notes", "channel": 11, "notes": [{"beat": 16, "note": 25, "duration": 4}, {"beat": 96, "note": 25, "duration": 4}, {"beat": 176, "note": 25, "duration": 4}]}, "voix": {"type": "notes", "channel": 14, "notes": [{"beat": 0, "note": 59, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Je suis bord\u00e9lique, un peu toqu\u00e9"}, {"beat": 44, "text": "Tout est m\u00e9lang\u00e9, je suis d\u00e9sorganis\u00e9"}, {"beat": 52, "text": "Des chaussettes ici, des cl\u00e9s l\u00e0-bas"}, {"beat": 60, "text": "Un vrai capharna\u00fcm mais c'est comme \u00e7a"}, {"beat": 68, "text": "Je suis bord\u00e9lique, \u00e7a me d\u00e9finit"}, {"beat": 76, "text": "Dans ce d\u00e9sordre, je trouve l'harmonie"}, {"beat": 84, "text": "Entre les piles de dossiers et les vieux journaux"}, {"beat": 92, "text": "Je vis ma vie dans ce joyeux chaos"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Je suis perfectionniste, c'est vrai aussi"}, {"beat": 124, "text": "Je veux que tout soit parfait, tout r\u00e9ussi"}, {"beat": 132, "text": "Les couleurs s'harmonisent, les formes s'alignent"}, {"beat": 140, "text": "M\u00eame si c'est parfois une lutte acharn\u00e9e"}, {"beat": 148, "text": "Je suis perfectionniste, dans l'extr\u00eame"}, {"beat": 156, "text": "Je veux que tout soit impeccable, je m'y bl\u00eame"}, {"beat": 164, "text": "Dans mon monde parfait, tout est bien plac\u00e9"}, {"beat": 172, "text": "M\u00eame si \u00e7a peut \u00eatre un peu obs\u00e9d\u00e9"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Je suis bord\u00e9lique et perfectionniste, yeah"}, {"beat": 220, "text": "Un vrai ph\u00e9nom\u00e8ne, un casse-t\u00eate, qu'est-ce que j'en fais"}, {"beat": 228, "text": "Mais c'est ma personnalit\u00e9, c'est ce qui me rend unique"}, {"beat": 236, "text": "Alors je m'\u00e9clate et je cultive ce c\u00f4t\u00e9 comique"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}