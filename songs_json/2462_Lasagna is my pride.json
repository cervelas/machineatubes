: 4}, {"beat": 212, "note": 41, "duration": 4}, {"beat": 216, "note": 39, "duration": 4}, {"beat": 220, "note": 39, "duration": 4}, {"beat": 224, "note": 41, "duration": 4}, {"beat": 228, "note": 41, "duration": 4}, {"beat": 232, "note": 39, "duration": 4}, {"beat": 236, "note": 39, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 35, "duration": 4}, {"beat": 96, "note": 35, "duration": 4}, {"beat": 176, "note": 35, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 41, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "In my kitchen, I have a blast,"}, {"beat": 44, "text": "Creating meatless dishes that I make fast."}, {"beat": 52, "text": "Today, I\u2019ll share my passion with glee,"}, {"beat": 60, "text": "Vegetarian lasagna, it\u2019s the one for me."}, {"beat": 68, "text": "Oh, I love to cook, lasagna's my pride,"}, {"beat": 76, "text": "A mix of colors and flavors, it\u2019s a joyful ride."}, {"beat": 84, "text": "With fresh veggies, I\u2019m as happy as can be,"}, {"beat": 92, "text": "Vegetarian lasagna, my go-to recipe."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "In my fridge, I keep all that I crave,"}, {"beat": 124, "text": "Zucchini, mushrooms, peppers, and more to save."}, {"beat": 132, "text": "I slice them thin while singing away,"}, {"beat": 140, "text": "Layer them between pasta, passionately I play."}, {"beat": 148, "text": "Oh, I love to cook, lasagna's my pride,"}, {"beat": 156, "text": "A recipe of love, my guests will be satisfied."}, {"beat": 164, "text": "With a touch of Parmesan, it\u2019s a grand delight,"}, {"beat": 172, "text": "Vegetarian lasagna, an overdose of taste so right."}, {"beat": 180, "text": "[solo]"}, {"beat": 212, "text": "Oh, I love to cook, lasagna's my pride,"}, {"beat": 220, "text": "A mix of colors and flavors, it\u2019s a joyful ride."}, {"beat": 228, "text": "With fresh veggies, I\u2019m as happy as can be,"}, {"beat": 236, "text": "Vegetarian lasagna, my go-to recipe."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}