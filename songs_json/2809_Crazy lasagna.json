}, {"beat": 172, "note": 37, "duration": 4}, {"beat": 208, "note": 41, "duration": 4}, {"beat": 212, "note": 38, "duration": 4}, {"beat": 216, "note": 39, "duration": 4}, {"beat": 220, "note": 37, "duration": 4}, {"beat": 224, "note": 41, "duration": 4}, {"beat": 228, "note": 38, "duration": 4}, {"beat": 232, "note": 39, "duration": 4}, {"beat": 236, "note": 37, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 20, "duration": 4}, {"beat": 96, "note": 20, "duration": 4}, {"beat": 176, "note": 20, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 40, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "With zucchini, peppers, and mushrooms too,"}, {"beat": 44, "text": "In my dancing pan, I prepare this blend so true."}, {"beat": 52, "text": "Delicate vegetables, sliced just right,"}, {"beat": 60, "text": "Vegetarian lasagna, ready for a delightful bite."}, {"beat": 68, "text": "Oh, crazy lasagna, it\u2019s my great passion,"}, {"beat": 76, "text": "I cook while dancing in my kitchen with action,"}, {"beat": 84, "text": "Colorful veggies, a symphony of taste,"}, {"beat": 92, "text": "Taste buds in celebration, bellies filled with grace."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "With a light b\u00e9chamel, all baked to a golden hue,"}, {"beat": 124, "text": "A true delight in your mouth, no meat but love so true,"}, {"beat": 132, "text": "Guests are amazed, they ask for more,"}, {"beat": 140, "text": "These vegetarian lasagnas, a feast to adore."}, {"beat": 148, "text": "Oh, crazy lasagna, it\u2019s my great passion,"}, {"beat": 156, "text": "I cook while dancing in my kitchen with action,"}, {"beat": 164, "text": "Colorful veggies, a symphony of taste,"}, {"beat": 172, "text": "Taste buds in celebration, bellies filled with grace."}, {"beat": 180, "text": "[solo]"}, {"beat": 212, "text": "So let\u2019s all sing together, celebrate the lasagna,"}, {"beat": 220, "text": "And dance without shame, to this catchy mantra,"}, {"beat": 228, "text": "Vegetarian lasagna, a hymn to joy,"}, {"beat": 236, "text": "In our plates and hearts, where indulgence is the ploy."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}