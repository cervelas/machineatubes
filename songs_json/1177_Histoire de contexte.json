eat": 160, "note": 16, "duration": 4}, {"beat": 164, "note": 16, "duration": 4}, {"beat": 168, "note": 15, "duration": 4}, {"beat": 172, "note": 15, "duration": 4}, {"beat": 208, "note": 16, "duration": 4}, {"beat": 212, "note": 16, "duration": 4}, {"beat": 216, "note": 15, "duration": 4}, {"beat": 220, "note": 15, "duration": 4}, {"beat": 224, "note": 16, "duration": 4}, {"beat": 228, "note": 16, "duration": 4}, {"beat": 232, "note": 15, "duration": 4}, {"beat": 236, "note": 15, "duration": 4}]}, "toplines": {"type": "notes", "channel": 9, "notes": [{"beat": 16, "note": 13, "duration": 4}, {"beat": 96, "note": 13, "duration": 4}, {"beat": 176, "note": 13, "duration": 4}]}, "voix": {"type": "notes", "channel": 12, "notes": [{"beat": 0, "note": 7, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Ya pas d'raison de se laisser abattre,"}, {"beat": 44, "text": "M\u00eame quand dans la vie \u00e7a part en vrille,"}, {"beat": 52, "text": "On va prendre \u00e7a \u00e0 la l\u00e9g\u00e8re, sans se battre,"}, {"beat": 60, "text": "On va faire tourner les t\u00eates, comme une vrille!"}, {"beat": 68, "text": "Dans ce monde \u00e9trange o\u00f9 tout est obscur,"}, {"beat": 76, "text": "J'me demande souvent, c'est quoi le contexte s\u00fbr ?"}, {"beat": 84, "text": "C'est un vrai casse-t\u00eate, une \u00e9nigme \u00e0 r\u00e9soudre,"}, {"beat": 92, "text": "Mais tout en musique, on va tout dissoudre!"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Certains disent qu'il faut \u00eatre s\u00e9rieux,"}, {"beat": 124, "text": "Mais moi j'pr\u00e9f\u00e8re l'humour, c'est bien plus pr\u00e9cieux,"}, {"beat": 132, "text": "On va faire rire les gens, m\u00eame dans l'adversit\u00e9,"}, {"beat": 140, "text": "Avec des blagues, des jeux de mots qui font p\u00e9ter!"}, {"beat": 148, "text": "Dans ce monde \u00e9trange o\u00f9 tout est obscur,"}, {"beat": 156, "text": "J'me demande souvent, c'est quoi le contexte s\u00fbr ?"}, {"beat": 164, "text": "C'est un vrai casse-t\u00eate, une \u00e9nigme \u00e0 r\u00e9soudre,"}, {"beat": 172, "text": "Mais tout en musique, on va tout dissoudre!"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors, on laisse le pass\u00e9 derri\u00e8re nous,"}, {"beat": 220, "text": "On avance avec l\u00e9g\u00e8ret\u00e9, sans remous,"}, {"beat": 228, "text": "On va croquer la vie, comme une pomme caram\u00e9lis\u00e9e,"}, {"beat": 236, "text": "Et faire danser les c\u0153urs avec nos m\u00e9lodies color\u00e9es!"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}