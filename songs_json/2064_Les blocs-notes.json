2, "note": 36, "duration": 4}, {"beat": 216, "note": 41, "duration": 4}, {"beat": 220, "note": 39, "duration": 4}, {"beat": 224, "note": 39, "duration": 4}, {"beat": 228, "note": 36, "duration": 4}, {"beat": 232, "note": 41, "duration": 4}, {"beat": 236, "note": 39, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 47, "duration": 4}, {"beat": 96, "note": 47, "duration": 4}, {"beat": 176, "note": 47, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 23, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Je prends ma plume, j'ouvre mon c\u0153ur,"}, {"beat": 44, "text": "Sur le bloc-notes, j'\u00e9cris en douceur,"}, {"beat": 52, "text": "Mes pens\u00e9es folles, mes mots l\u00e9gers,"}, {"beat": 60, "text": "Je suis l'encre qui va te charmer."}, {"beat": 68, "text": "\u00c9crire sur des blocs-notes, c'est ma passion,"}, {"beat": 76, "text": "Une symphonie de rimes et d'\u00e9motions,"}, {"beat": 84, "text": "Avec mes mots je fais des pirouettes,"}, {"beat": 92, "text": "Je suis le clown des mots, la reine des pirouettes."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Je dessine des vers, des jeux de mots,"}, {"beat": 124, "text": "Sur mon papier blanc, tout est bient\u00f4t beau,"}, {"beat": 132, "text": "Les id\u00e9es fusent, c'est un tourbillon,"}, {"beat": 140, "text": "Je d\u00e9roule mon encre avec d\u00e9raison."}, {"beat": 148, "text": "\u00c9crire sur des blocs-notes, c'est mon bonheur,"}, {"beat": 156, "text": "Un jeu de mots qui d\u00e9fie les heures,"}, {"beat": 164, "text": "Avec ma plume, j'\u00e9cris des cascades,"}, {"beat": 172, "text": "Je suis le prince des mots, le roi des acrobaties."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Sur les blocs-notes, mes mots dansent,"}, {"beat": 220, "text": "Ils \u00e9claboussent la feuille, deviennent une danse,"}, {"beat": 228, "text": "Alors viens, rejoins mon \u00e9criture l\u00e9g\u00e8re,"}, {"beat": 236, "text": "Et ensemble, dansons sur cette m\u00e9lodie sinc\u00e8re."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}