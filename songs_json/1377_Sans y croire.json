ote": 40, "duration": 4}, {"beat": 168, "note": 39, "duration": 4}, {"beat": 172, "note": 39, "duration": 4}, {"beat": 208, "note": 37, "duration": 4}, {"beat": 212, "note": 40, "duration": 4}, {"beat": 216, "note": 39, "duration": 4}, {"beat": 220, "note": 39, "duration": 4}, {"beat": 224, "note": 37, "duration": 4}, {"beat": 228, "note": 40, "duration": 4}, {"beat": 232, "note": 39, "duration": 4}, {"beat": 236, "note": 39, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 28, "duration": 4}, {"beat": 96, "note": 28, "duration": 4}, {"beat": 176, "note": 28, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 3, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Je vais \u00e0 la gym, mais je ne peux m'emp\u00eacher de rire"}, {"beat": 44, "text": "Les poids sont trop lourds, je me fais toujours ch\u00e9rir"}, {"beat": 52, "text": "Je l\u00e8ve juste les bras, pour impressionner tout le monde"}, {"beat": 60, "text": "Mais je ne suis qu'une starlette dans le monde des blondes"}, {"beat": 68, "text": "J'ai essay\u00e9 d'\u00eatre s\u00e9rieux, d'aller de l'avant"}, {"beat": 76, "text": "Mais sans y croire, \u00e7a n'avance pas vraiment"}, {"beat": 84, "text": "Alors je pr\u00e9f\u00e8re prendre \u00e7a avec l\u00e9g\u00e8ret\u00e9"}, {"beat": 92, "text": "La vie est bien trop courte pour se stresser"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "J'ai voulu \u00eatre s\u00e9rieux dans mes relations amoureuses"}, {"beat": 124, "text": "Mais sans y croire, je finis toujours en eaux tumultueuses"}, {"beat": 132, "text": "Alors je pr\u00e9f\u00e8re flirter, papillonner d'un coeur \u00e0 l'autre"}, {"beat": 140, "text": "L'amour n'est qu'un jeu, autant en rire plut\u00f4t que d'\u00eatre au pied du m\u00e8tre"}, {"beat": 148, "text": "J'ai essay\u00e9 d'\u00eatre s\u00e9rieux, d'aller de l'avant"}, {"beat": 156, "text": "Mais sans y croire, \u00e7a n'avance pas vraiment"}, {"beat": 164, "text": "Alors je pr\u00e9f\u00e8re prendre \u00e7a avec l\u00e9g\u00e8ret\u00e9"}, {"beat": 172, "text": "La vie est bien trop courte pour se stresser"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors, chers amis, ne vous prenez pas trop au s\u00e9rieux"}, {"beat": 220, "text": "Profitez de la vie, faites des blagues, soyez joyeux"}, {"beat": 228, "text": "Car au bout du compte, \u00e7a sert \u00e0 rien d'essayer"}, {"beat": 236, "text": "Si on n'y croit pas, autant tout prendre avec gaiet\u00e9"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}