e": 37, "duration": 4}, {"beat": 160, "note": 39, "duration": 4}, {"beat": 164, "note": 39, "duration": 4}, {"beat": 168, "note": 37, "duration": 4}, {"beat": 172, "note": 37, "duration": 4}, {"beat": 208, "note": 39, "duration": 4}, {"beat": 212, "note": 39, "duration": 4}, {"beat": 216, "note": 37, "duration": 4}, {"beat": 220, "note": 37, "duration": 4}, {"beat": 224, "note": 39, "duration": 4}, {"beat": 228, "note": 39, "duration": 4}, {"beat": 232, "note": 37, "duration": 4}, {"beat": 236, "note": 37, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 77, "duration": 4}, {"beat": 96, "note": 77, "duration": 4}, {"beat": 176, "note": 77, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 77, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "In this complex world, with so much at stake,"}, {"beat": 44, "text": "I don\u2019t care, I\u2019d rather entertain for fun's sake."}, {"beat": 52, "text": "No need to pick sides in every story told,"}, {"beat": 60, "text": "I just want to see folks laughing and bold."}, {"beat": 68, "text": "I mock it all, I\u2019m not too serious,"}, {"beat": 76, "text": "Controversy\u2019s dull, it\u2019s just too tedious."}, {"beat": 84, "text": "I prefer the laughs, the jokes, and the play,"}, {"beat": 92, "text": "Living light-hearted, not taking life too seriously each day."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Debates and verbal fights are not for me,"}, {"beat": 124, "text": "I\u2019d rather embrace jokes and let them be."}, {"beat": 132, "text": "In this sea of tension, I sail with ease,"}, {"beat": 140, "text": "I disregard scandals and friendships I please."}, {"beat": 148, "text": "I mock it all, a bit whimsical too,"}, {"beat": 156, "text": "Controversies just drift right over my view."}, {"beat": 164, "text": "Nothing stops me, I spread cheer in song,"}, {"beat": 172, "text": "My goal is to make people smile all along."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "So friends, don\u2019t take life too seriously,"}, {"beat": 220, "text": "Life\u2019s too short for debates so endlessly."}, {"beat": 228, "text": "Let\u2019s choose laughter and moments so light,"}, {"beat": 236, "text": "For that\u2019s what makes friendship truly bright."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}