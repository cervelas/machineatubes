 {"beat": 220, "note": 39, "duration": 4}, {"beat": 224, "note": 38, "duration": 4}, {"beat": 228, "note": 41, "duration": 4}, {"beat": 232, "note": 39, "duration": 4}, {"beat": 236, "note": 39, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 58, "duration": 4}, {"beat": 96, "note": 58, "duration": 4}, {"beat": 176, "note": 58, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 65, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Je suis un peu na\u00eff, c'est ma sp\u00e9cialit\u00e9"}, {"beat": 44, "text": "Je me laisse emporter par leur simplicit\u00e9"}, {"beat": 52, "text": "Ils ont le verbe facile, une grande \u00e9loquence"}, {"beat": 60, "text": "Et moi je tombe dans leur pi\u00e8ge avec insouciance"}, {"beat": 68, "text": "J'accroche \u00e0 tout le monde, c'est ma faiblesse"}, {"beat": 76, "text": "Je suis facilement convaincu, sans maladresse"}, {"beat": 84, "text": "Tous les beaux parleurs, les persuadeurs"}, {"beat": 92, "text": "J'accroche \u00e0 tout le monde, m\u00eame les imposteurs"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Les promesses enj\u00f4leuses, \u00e7a me fait tourner la t\u00eate"}, {"beat": 124, "text": "Je me fais embarquer dans leurs histoires abstraites"}, {"beat": 132, "text": "Ils utilisent leurs sourires, comme des armes fatales"}, {"beat": 140, "text": "Et moi je me retrouve pris au pi\u00e8ge de leurs r\u00eaves anarchiques"}, {"beat": 148, "text": "J'accroche \u00e0 tout le monde, c'est ma faiblesse"}, {"beat": 156, "text": "Je suis facilement convaincu, sans maladresse"}, {"beat": 164, "text": "Tous les beaux parleurs, les persuadeurs"}, {"beat": 172, "text": "J'accroche \u00e0 tout le monde, m\u00eame les imposteurs"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "J'accroche \u00e0 tout le monde, mais je grandis petit \u00e0 petit"}, {"beat": 220, "text": "Je commence \u00e0 comprendre, \u00e0 ne plus me laisser s\u00e9duire ainsi"}, {"beat": 228, "text": "Peut-\u00eatre qu'un jour, je deviendrai plus cynique"}, {"beat": 236, "text": "Mais pour l'instant, j'accroche encore \u00e0 tout ce qui brille."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}