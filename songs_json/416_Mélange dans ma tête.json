"beat": 164, "note": 27, "duration": 4}, {"beat": 168, "note": 29, "duration": 4}, {"beat": 172, "note": 26, "duration": 4}, {"beat": 208, "note": 24, "duration": 4}, {"beat": 212, "note": 27, "duration": 4}, {"beat": 216, "note": 29, "duration": 4}, {"beat": 220, "note": 26, "duration": 4}, {"beat": 224, "note": 24, "duration": 4}, {"beat": 228, "note": 27, "duration": 4}, {"beat": 232, "note": 29, "duration": 4}, {"beat": 236, "note": 26, "duration": 4}]}, "toplines": {"type": "notes", "channel": 11, "notes": [{"beat": 16, "note": 29, "duration": 4}, {"beat": 96, "note": 29, "duration": 4}, {"beat": 176, "note": 29, "duration": 4}]}, "voix": {"type": "notes", "channel": 14, "notes": [{"beat": 0, "note": 7, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Dans ma t\u00eate, c'est tout m\u00e9lang\u00e9,"}, {"beat": 44, "text": "Chaque jour, je ne fais que naviguer,"}, {"beat": 52, "text": "Entre le s\u00e9rieux et l'absurdit\u00e9,"}, {"beat": 60, "text": "C'est vrai, c'est une question de contexte, tu vois?"}, {"beat": 68, "text": "C'est plut\u00f4t une question de contexte,"}, {"beat": 76, "text": "\u00c7a change tout, c'est un effet complexe,"}, {"beat": 84, "text": "Tu peux rire ou bien rester perplexe,"}, {"beat": 92, "text": "Car la vie, c'est surprenant, voil\u00e0 le texte!"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Ce matin, j'ai mis ma plus belle tenue,"}, {"beat": 124, "text": "Mais dans le m\u00e9tro, j'ai march\u00e9 dans une flaque de boue,"}, {"beat": 132, "text": "Tout le monde rigole, moi j'ai l'air d'un fou,"}, {"beat": 140, "text": "C'est vrai, c'est une question de contexte, c'est fou!"}, {"beat": 148, "text": "C'est plut\u00f4t une question de contexte,"}, {"beat": 156, "text": "\u00c7a change tout, c'est un effet complexe,"}, {"beat": 164, "text": "Tu peux rire ou bien rester perplexe,"}, {"beat": 172, "text": "Car la vie, c'est surprenant, voil\u00e0 le texte!"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors, ne prends pas tout trop au s\u00e9rieux,"}, {"beat": 220, "text": "Ris, amuse-toi, c'est le secret des heureux,"}, {"beat": 228, "text": "La vie est un grand voyage, une vaste com\u00e9die,"}, {"beat": 236, "text": "Et dans ce contexte, soyons tous des artistes!"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}