}, {"beat": 216, "note": 41, "duration": 4}, {"beat": 220, "note": 41, "duration": 4}, {"beat": 224, "note": 37, "duration": 4}, {"beat": 228, "note": 38, "duration": 4}, {"beat": 232, "note": 41, "duration": 4}, {"beat": 236, "note": 41, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 18, "duration": 4}, {"beat": 96, "note": 18, "duration": 4}, {"beat": 176, "note": 18, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 57, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "One day at the circus, I got quite a shock,"}, {"beat": 44, "text": "A clown appeared right on my back like a rock."}, {"beat": 52, "text": "He made me laugh, but I also shook with fear,"}, {"beat": 60, "text": "Those red noses give me sleepless nights, it\u2019s clear."}, {"beat": 68, "text": "Clowns, oh clowns, I just can\u2019t stand,"}, {"beat": 76, "text": "Their funny faces make me feel so unplanned."}, {"beat": 84, "text": "Clowns, oh clowns, I can't abide,"}, {"beat": 92, "text": "Their humor\u2019s too strange for me to confide."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "They wear huge shoes, their makeup\u2019s a sight,"}, {"beat": 124, "text": "They juggle and dance with all their might."}, {"beat": 132, "text": "They spin and they twirl, it\u2019s quite a show,"}, {"beat": 140, "text": "But I\u2019d rather listen to love songs, you know."}, {"beat": 148, "text": "Clowns, oh clowns, I just can\u2019t stand,"}, {"beat": 156, "text": "Their funny faces make me feel so unplanned."}, {"beat": 164, "text": "Clowns, oh clowns, I can't abide,"}, {"beat": 172, "text": "Their humor\u2019s too strange for me to confide."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "So don\u2019t get mad, dear audience,"}, {"beat": 220, "text": "It\u2019s just a song, no need for pretense."}, {"beat": 228, "text": "Clowns will still make a grand sensation,"}, {"beat": 236, "text": "But I\u2019ll remain the king of imitation."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}