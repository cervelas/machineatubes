4}, {"beat": 168, "note": 37, "duration": 4}, {"beat": 172, "note": 36, "duration": 4}, {"beat": 208, "note": 41, "duration": 4}, {"beat": 212, "note": 39, "duration": 4}, {"beat": 216, "note": 37, "duration": 4}, {"beat": 220, "note": 36, "duration": 4}, {"beat": 224, "note": 41, "duration": 4}, {"beat": 228, "note": 39, "duration": 4}, {"beat": 232, "note": 37, "duration": 4}, {"beat": 236, "note": 36, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 60, "duration": 4}, {"beat": 96, "note": 60, "duration": 4}, {"beat": 176, "note": 60, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 65, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "I'm a bit na\u00efve, it's my specialty,"}, {"beat": 44, "text": "I get swept away by their simplicity,"}, {"beat": 52, "text": "They speak with ease, with great eloquence,"}, {"beat": 60, "text": "And I fall into their trap with innocence."}, {"beat": 68, "text": "I latch on to everyone, it\u2019s my weakness,"}, {"beat": 76, "text": "Easily convinced, without much finesse,"}, {"beat": 84, "text": "All the smooth talkers, the persuaders,"}, {"beat": 92, "text": "I latch on to everyone, even the deceivers."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Enticing promises, they spin my head,"}, {"beat": 124, "text": "I get caught up in their abstract threads,"}, {"beat": 132, "text": "They use their smiles like deadly charms,"}, {"beat": 140, "text": "And I find myself trapped by their chaotic alarms."}, {"beat": 148, "text": "I latch on to everyone, it\u2019s my weakness,"}, {"beat": 156, "text": "Easily convinced, without much finesse,"}, {"beat": 164, "text": "All the smooth talkers, the persuaders,"}, {"beat": 172, "text": "I latch on to everyone, even the deceivers."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "I latch on to everyone, but I'm growing bit by bit,"}, {"beat": 220, "text": "I\u2019m starting to understand, not to be misled by wit,"}, {"beat": 228, "text": "Maybe one day I\u2019ll become more cynical,"}, {"beat": 236, "text": "But for now, I still cling to all that\u2019s whimsical."}, {"beat": 244, "text": "[ outro ]"}, {"beat": 252, "text": ""}]}}}