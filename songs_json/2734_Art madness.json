 172, "note": 41, "duration": 4}, {"beat": 208, "note": 37, "duration": 4}, {"beat": 212, "note": 39, "duration": 4}, {"beat": 216, "note": 41, "duration": 4}, {"beat": 220, "note": 41, "duration": 4}, {"beat": 224, "note": 37, "duration": 4}, {"beat": 228, "note": 39, "duration": 4}, {"beat": 232, "note": 41, "duration": 4}, {"beat": 236, "note": 41, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 104, "duration": 4}, {"beat": 96, "note": 104, "duration": 4}, {"beat": 176, "note": 104, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 43, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "intro]"}, {"beat": 36, "text": "In stuffy museums, I feel so out of place,"}, {"beat": 44, "text": "With my creative madness, I\u2019ll brush off their grace."}, {"beat": 52, "text": "No need for a Picasso to learn how to appreciate,"}, {"beat": 60, "text": "True genius lies in simplicity\u2019s state."}, {"beat": 68, "text": "I love accessible art, no headaches or stress,"}, {"beat": 76, "text": "A splash of color, a tune to impress."}, {"beat": 84, "text": "Talented artists, those who make us sway,"}, {"beat": 92, "text": "Crazy art\u2019s all I need to brighten my day."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "I\u2019m a total hoot, a clown so unique,"}, {"beat": 124, "text": "My vibrant canvases have a carnival streak."}, {"beat": 132, "text": "I scribble verses, with humor to share,"}, {"beat": 140, "text": "For those who want to escape without a care."}, {"beat": 148, "text": "I love accessible art, light as a feather,"}, {"beat": 156, "text": "When it speaks to all and brings us together."}, {"beat": 164, "text": "Funny rhymes, songs that make us cheer,"}, {"beat": 172, "text": "Crazy art\u2019s what makes my passion clear."}, {"beat": 180, "text": "[solo]"}, {"beat": 212, "text": "Let art sweep you away, with no fuss or confusion,"}, {"beat": 220, "text": "Laugh, dance, feel this vibrant infusion."}, {"beat": 228, "text": "For accessible art is a true treasure,"}, {"beat": 236, "text": "That makes us laugh and feel pleasure."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}