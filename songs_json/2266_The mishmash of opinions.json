ation": 4}, {"beat": 160, "note": 41, "duration": 4}, {"beat": 164, "note": 41, "duration": 4}, {"beat": 168, "note": 39, "duration": 4}, {"beat": 172, "note": 39, "duration": 4}, {"beat": 208, "note": 41, "duration": 4}, {"beat": 212, "note": 41, "duration": 4}, {"beat": 216, "note": 39, "duration": 4}, {"beat": 220, "note": 39, "duration": 4}, {"beat": 224, "note": 41, "duration": 4}, {"beat": 228, "note": 41, "duration": 4}, {"beat": 232, "note": 39, "duration": 4}, {"beat": 236, "note": 39, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 71, "duration": 4}, {"beat": 96, "note": 71, "duration": 4}, {"beat": 176, "note": 71, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 80, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "In this curious world, everyone has their say,"}, {"beat": 44, "text": "We love to debate, even when we disagree, it\u2019s the way."}, {"beat": 52, "text": "Some say yes, others say no, each with their conviction,"}, {"beat": 60, "text": "But when we gather, it's a clash of opinions\u2019 friction."}, {"beat": 68, "text": "The jumble of views, it goes every which way,"}, {"beat": 76, "text": "We barely listen, we talk much louder, let\u2019s sway."}, {"beat": 84, "text": "The jumble of views, it sparks and it flies,"}, {"beat": 92, "text": "But beneath all this racket, the truth still lies."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Some are radical, always convinced they're right,"}, {"beat": 124, "text": "Others are uncertain, seeking perfection\u2019s light."}, {"beat": 132, "text": "But I say we can agree even if we don\u2019t align,"}, {"beat": 140, "text": "Let\u2019s give a little room, find common ground divine."}, {"beat": 148, "text": "The jumble of views, it goes every which way,"}, {"beat": 156, "text": "We barely listen, we talk much louder, let\u2019s sway."}, {"beat": 164, "text": "The jumble of views, it sparks and it flies,"}, {"beat": 172, "text": "But beneath all this racket, the truth still lies."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "The jumble of views, it\u2019s our quirky dance,"}, {"beat": 220, "text": "In this joyful disorder, we find balance and chance."}, {"beat": 228, "text": "So let\u2019s all sing together, in this world so split,"}, {"beat": 236, "text": "The jumble of views, it\u2019s our eternal wit."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}