ar je suis l\u00e0 pour vous faire sourire, vous faire rire"}, {"beat": 172, "text": "Je suis le roi de la f\u00eate, le clown du divertissement"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Je veux faire du pop, du pop partout o\u00f9 je vais"}, {"beat": 220, "text": "Chanter, danser, faire vibrer ce monde \u00e0 jamais"}, {"beat": 228, "text": "Je veux du succ\u00e8s, de la gloire et des fans en d\u00e9lire"}, {"beat": 236, "text": "Je veux faire sensation, je veux faire carri\u00e8re"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}