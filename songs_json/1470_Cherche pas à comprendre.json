on": 4}, {"beat": 224, "note": 13, "duration": 4}, {"beat": 228, "note": 16, "duration": 4}, {"beat": 232, "note": 14, "duration": 4}, {"beat": 236, "note": 14, "duration": 4}]}, "toplines": {"type": "notes", "channel": 9, "notes": [{"beat": 16, "note": 2, "duration": 4}, {"beat": 96, "note": 2, "duration": 4}, {"beat": 176, "note": 2, "duration": 4}]}, "voix": {"type": "notes", "channel": 12, "notes": [{"beat": 0, "note": 57, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Assis dans mon coin, tout seul je m\u00e9dite,"}, {"beat": 44, "text": "Mes soucis s'accumulent \u00e0 l'infini,"}, {"beat": 52, "text": "Rien n'est logique, tout est si bizarr'."}, {"beat": 60, "text": "Un jour je ris, le lendemain des pleurs \u00e9clatent au hasard."}, {"beat": 68, "text": "Je me perds dans mes pens\u00e9es, tu sais,"}, {"beat": 76, "text": "Penser que c'est cheap, c'est jamais gai,"}, {"beat": 84, "text": "La vie est parfois si mal arrang\u00e9e,"}, {"beat": 92, "text": "Cherche pas \u00e0 comprendre, laisse-moi d\u00e9railler."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Les gens me regardent avec des yeux perdus,"}, {"beat": 124, "text": "Ils trouvent mes probl\u00e8mes bien ridicules,"}, {"beat": 132, "text": "Mais moi j'y tiens, \u00e0 mes histoires d\u00e9cal\u00e9es,"}, {"beat": 140, "text": "C'est mon cr\u00e9neau, ma fa\u00e7on de rester branch\u00e9."}, {"beat": 148, "text": "J'essaie de garder le sourire, tu sais,"}, {"beat": 156, "text": "Mais parfois dans ma t\u00eate tout se d\u00e9chire,"}, {"beat": 164, "text": "C'est une chanson triste, noy\u00e9e dans le cheap,"}, {"beat": 172, "text": "Cherche pas \u00e0 comprendre, laisse-moi dans mon spleen d\u00e9licieusement creep."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors je chante ma m\u00e9lodie bizarre,"}, {"beat": 220, "text": "Avec des refrains incompr\u00e9hensibles et brouillards,"}, {"beat": 228, "text": "C'est tellement chee-e-e-e-e-e-e-ep,"}, {"beat": 236, "text": "Cherche pas \u00e0 comprendre, viens danser avec moi dans ce monde sans rep\u00e8res."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}