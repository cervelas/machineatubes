at": 212, "note": 40, "duration": 4}, {"beat": 216, "note": 38, "duration": 4}, {"beat": 220, "note": 37, "duration": 4}, {"beat": 224, "note": 36, "duration": 4}, {"beat": 228, "note": 40, "duration": 4}, {"beat": 232, "note": 38, "duration": 4}, {"beat": 236, "note": 37, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 25, "duration": 4}, {"beat": 96, "note": 25, "duration": 4}, {"beat": 176, "note": 25, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 69, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "In the morning, I wake up, everything seems neat,"}, {"beat": 44, "text": "But soon, I\u2019m tempted to turn it all to defeat."}, {"beat": 52, "text": "I pair my socks with my shoes, so unaligned,"}, {"beat": 60, "text": "Daily routines, I love to undermine."}, {"beat": 68, "text": "In my well-ordered life, everything's in place,"}, {"beat": 76, "text": "But I can\u2019t help but make a mess with grace."}, {"beat": 84, "text": "I see no point in staying all too prim,"}, {"beat": 92, "text": "So here's to the chaos, let me live on a whim!"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "At home, the furniture's all in its place,"}, {"beat": 124, "text": "But I prefer to move it, to change its space."}, {"beat": 132, "text": "A bit of chaos clears my mind so free,"}, {"beat": 140, "text": "Let things live and dance in a sweet disarray."}, {"beat": 148, "text": "In my well-ordered life, everything's in place,"}, {"beat": 156, "text": "But I can\u2019t help but make a mess with grace."}, {"beat": 164, "text": "I see no point in staying all too prim,"}, {"beat": 172, "text": "So here's to the chaos, let me live on a whim!"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Let me live my life, full of disorder and spree,"}, {"beat": 220, "text": "Chaos gives me energy, it's my melody."}, {"beat": 228, "text": "I see no point in bending to conventions so tight,"}, {"beat": 236, "text": "So here's to the mess, it\u2019s my own fight!"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}