}, {"beat": 168, "note": 41, "duration": 4}, {"beat": 172, "note": 39, "duration": 4}, {"beat": 208, "note": 39, "duration": 4}, {"beat": 212, "note": 40, "duration": 4}, {"beat": 216, "note": 41, "duration": 4}, {"beat": 220, "note": 39, "duration": 4}, {"beat": 224, "note": 39, "duration": 4}, {"beat": 228, "note": 40, "duration": 4}, {"beat": 232, "note": 41, "duration": 4}, {"beat": 236, "note": 39, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 27, "duration": 4}, {"beat": 96, "note": 27, "duration": 4}, {"beat": 176, "note": 27, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 108, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Tired of the daily grind, everything\u2019s so gray,"}, {"beat": 44, "text": "Need a splash of whimsy, a touch of play."}, {"beat": 52, "text": "I\u2019m diving in, no turning back,"}, {"beat": 60, "text": "Towards a future that's full of slack."}, {"beat": 68, "text": "I crave a change, a fresh new view,"}, {"beat": 76, "text": "To explore new paradises, bright and true."}, {"beat": 84, "text": "A new chapter, that\u2019s what I need,"}, {"beat": 92, "text": "Throwing my worries to the sea!"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "I want to see the world in technicolor,"}, {"beat": 124, "text": "Laugh for no reason, lose all sense of order."}, {"beat": 132, "text": "Goodbye worries, hello freedom\u2019s embrace,"}, {"beat": 140, "text": "Escaping the monotony at a brisk pace."}, {"beat": 148, "text": "I\u2019ll dance through my troubles,"}, {"beat": 156, "text": "Party on, forgetting the struggles."}, {"beat": 164, "text": "A new start, that\u2019s what I want,"}, {"beat": 172, "text": "Living life completely, with no taunt."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "I\u2019ll be the Master of laughter,"}, {"beat": 220, "text": "On stage, shining bright, breaking free after."}, {"beat": 228, "text": "With my voice, I'll make it sing,"}, {"beat": 236, "text": "The whole world, in joy, I'll bring."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}