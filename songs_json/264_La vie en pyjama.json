}, {"beat": 208, "note": 15, "duration": 4}, {"beat": 212, "note": 15, "duration": 4}, {"beat": 216, "note": 13, "duration": 4}, {"beat": 220, "note": 13, "duration": 4}, {"beat": 224, "note": 15, "duration": 4}, {"beat": 228, "note": 15, "duration": 4}, {"beat": 232, "note": 13, "duration": 4}, {"beat": 236, "note": 13, "duration": 4}]}, "toplines": {"type": "notes", "channel": 9, "notes": [{"beat": 16, "note": 14, "duration": 4}, {"beat": 96, "note": 14, "duration": 4}, {"beat": 176, "note": 14, "duration": 4}]}, "voix": {"type": "notes", "channel": 12, "notes": [{"beat": 0, "note": 64, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Je me r\u00e9veille chaque matin, les yeux encore endormis"}, {"beat": 44, "text": "La flemme me tient dans ses bras, impossible de me lever d'ici"}, {"beat": 52, "text": "J'enfile mon pyjama, je m'installe dans mon lit douillet"}, {"beat": 60, "text": "La vie est trop courte pour se presser, je pr\u00e9f\u00e8re r\u00eavasser aux mille et une folies"}, {"beat": 68, "text": "La vie en pyjama, c'est tout ce que je veux"}, {"beat": 76, "text": "Sous la couette, bien au chaud, je suis heureux"}, {"beat": 84, "text": "Paresseux, tire-au-flanc, c'est ma philosophie"}, {"beat": 92, "text": "Je suis le roi de la fain\u00e9antise, vive la vie en pyjama, oui oui"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Mes amis me critiquent, ils disent que je suis trop feignant"}, {"beat": 124, "text": "Mais je m'en moque, je suis bien dans mon petit cocon indulgent"}, {"beat": 132, "text": "Je regarde les heures passer, les t\u00e2ches s'accumuler"}, {"beat": 140, "text": "Mais je reste ici, dans mon pyjama, \u00e0 me laisser aller"}, {"beat": 148, "text": "La vie en pyjama, c'est tout ce que je veux"}, {"beat": 156, "text": "Sous la couette, bien au chaud, je suis heureux"}, {"beat": 164, "text": "Paresseux, tire-au-flanc, c'est ma philosophie"}, {"beat": 172, "text": "Je suis le roi de la fain\u00e9antise, vive la vie en pyjama, oui oui"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors rejoins-moi, laisse tes soucis derri\u00e8re"}, {"beat": 220, "text": "En pyjama, on se laisse porter par l'air l\u00e9ger"}, {"beat": 228, "text": "La vie est parfois trop s\u00e9rieuse, tu le sais bien"}, {"beat": 236, "text": "Alors viens, amusons-nous, dansons sous la lune et oublions nos chagrins"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}