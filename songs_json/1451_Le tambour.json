": 14, "duration": 4}, {"beat": 172, "note": 14, "duration": 4}, {"beat": 208, "note": 12, "duration": 4}, {"beat": 212, "note": 13, "duration": 4}, {"beat": 216, "note": 14, "duration": 4}, {"beat": 220, "note": 14, "duration": 4}, {"beat": 224, "note": 12, "duration": 4}, {"beat": 228, "note": 13, "duration": 4}, {"beat": 232, "note": 14, "duration": 4}, {"beat": 236, "note": 14, "duration": 4}]}, "toplines": {"type": "notes", "channel": 9, "notes": [{"beat": 16, "note": 59, "duration": 4}, {"beat": 96, "note": 59, "duration": 4}, {"beat": 176, "note": 59, "duration": 4}]}, "voix": {"type": "notes", "channel": 12, "notes": [{"beat": 0, "note": 15, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "J'\u00e9tais un gamin, plein d'espoir et de r\u00eaves,"}, {"beat": 44, "text": "\u00c0 la ludoth\u00e8que, je cherchais la tr\u00eave."}, {"beat": 52, "text": "Et l\u00e0 j'ai trouv\u00e9, tel un tr\u00e9sor enfantin,"}, {"beat": 60, "text": "Un tambour en plastique, qui ferait mon destin."}, {"beat": 68, "text": "Le tambour en plastique, mon ami de toujours,"}, {"beat": 76, "text": "Jouait des m\u00e9lodies dans mon monde d'amour."}, {"beat": 84, "text": "Au son de mes baguettes, les rires se m\u00e9langeaient,"}, {"beat": 92, "text": "Cette histoire d'enfance, jamais ne m'oublierai."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Je l'ai emport\u00e9, ce tambour fid\u00e8le,"}, {"beat": 124, "text": "Dans tous mes voyages, jusqu'au mod\u00e8le."}, {"beat": 132, "text": "Du m\u00e9tro bond\u00e9, aux ruelles de Paris,"}, {"beat": 140, "text": "Son bruit enchant\u00e9, me donnait la vie."}, {"beat": 148, "text": "Le tambour en plastique, mon ami de toujours,"}, {"beat": 156, "text": "Jouait des m\u00e9lodies dans mon monde d'amour."}, {"beat": 164, "text": "Au son de mes baguettes, les rires se m\u00e9langeaient,"}, {"beat": 172, "text": "Cette histoire d'enfance, jamais ne m'oublierai."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors je chante cette chanson, l\u00e9g\u00e8re et douce,"}, {"beat": 220, "text": "Pour tous les bambins, qui gardent les \u00e9toiles en bouche."}, {"beat": 228, "text": "Et peut-\u00eatre un jour, un autre tambour deviendra,"}, {"beat": 236, "text": "Le symbole d'un r\u00eave qui ne s'\u00e9chappera pas."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}