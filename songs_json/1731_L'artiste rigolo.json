}, {"beat": 208, "note": 37, "duration": 4}, {"beat": 212, "note": 36, "duration": 4}, {"beat": 216, "note": 40, "duration": 4}, {"beat": 220, "note": 39, "duration": 4}, {"beat": 224, "note": 37, "duration": 4}, {"beat": 228, "note": 36, "duration": 4}, {"beat": 232, "note": 40, "duration": 4}, {"beat": 236, "note": 39, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 16, "duration": 4}, {"beat": 96, "note": 16, "duration": 4}, {"beat": 176, "note": 16, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 124, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Dans ce pays de montagnes et de chocolats,"}, {"beat": 44, "text": "Je suis un artiste, Oh l\u00e0 l\u00e0, c'est rigolo,"}, {"beat": 52, "text": "Sur sc\u00e8ne je danse, je chante, je fais le show,"}, {"beat": 60, "text": "Mais jamais trop s\u00e9rieux, car ici la vie est beau."}, {"beat": 68, "text": "Je suis l'artiste suisse rigolo,"}, {"beat": 76, "text": "Avec mon sourire, je fais le show,"}, {"beat": 84, "text": "Entre les Alpes et les lacs, je m'\u00e9clate comme il se doit,"}, {"beat": 92, "text": "L'artiste suisse rigolo, toujours plein de joie."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Avec ma guitare et mes rimes, je raconte des histoires,"}, {"beat": 124, "text": "Les Suisses me suivent, car j'ai le c\u0153ur en or,"}, {"beat": 132, "text": "Sur sc\u00e8ne, je m'exprime, je partage mon amour,"}, {"beat": 140, "text": "Et du fond des montagnes, jaillit notre bonheur."}, {"beat": 148, "text": "Je suis l'artiste suisse rigolo,"}, {"beat": 156, "text": "Avec mon sourire, je fais le show,"}, {"beat": 164, "text": "Entre les Alpes et les lacs, je m'\u00e9clate comme il se doit,"}, {"beat": 172, "text": "L'artiste suisse rigolo, toujours plein de joie."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Et quand la neige tombe, tout devient f\u00e9\u00e9rique,"}, {"beat": 220, "text": "Je me sens libre, je me sens magique,"}, {"beat": 228, "text": "Je sais que le rire est notre plus belle musique,"}, {"beat": 236, "text": "Et en Suisse, on sait bien s'amuser, c'est logique."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}