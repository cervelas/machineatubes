e": 39, "duration": 4}, {"beat": 208, "note": 40, "duration": 4}, {"beat": 212, "note": 37, "duration": 4}, {"beat": 216, "note": 36, "duration": 4}, {"beat": 220, "note": 39, "duration": 4}, {"beat": 224, "note": 40, "duration": 4}, {"beat": 228, "note": 37, "duration": 4}, {"beat": 232, "note": 36, "duration": 4}, {"beat": 236, "note": 39, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 99, "duration": 4}, {"beat": 96, "note": 99, "duration": 4}, {"beat": 176, "note": 99, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 18, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Ce monde est fou, rempli de fous,"}, {"beat": 44, "text": "Tout le monde s'offense, c'est plus du tout doux,"}, {"beat": 52, "text": "Un mot mal plac\u00e9, une blague en l'air,"}, {"beat": 60, "text": "Et voil\u00e0 que les gens se mettent \u00e0 crier."}, {"beat": 68, "text": "Offens\u00e9, pas offens\u00e9, on ne sait plus quoi penser,"}, {"beat": 76, "text": "Chacun trouve une raison de s'offusquer,"}, {"beat": 84, "text": "Mais moi, je dis, arr\u00eatons de se f\u00e2cher,"}, {"beat": 92, "text": "Vivons la vie sans se prendre la t\u00eate."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "On marche sur des \u0153ufs, on fait attention,"}, {"beat": 124, "text": "\u00c0 chaque mot, \u00e0 chaque expression,"}, {"beat": 132, "text": "Mais moi je propose une autre solution,"}, {"beat": 140, "text": "Rire de tout, sans r\u00e9servation."}, {"beat": 148, "text": "Offens\u00e9, pas offens\u00e9, on ne sait plus quoi penser,"}, {"beat": 156, "text": "Chacun trouve une raison de s'offusquer,"}, {"beat": 164, "text": "Mais moi, je dis, arr\u00eatons de se f\u00e2cher,"}, {"beat": 172, "text": "Vivons la vie sans se prendre la t\u00eate."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Car apr\u00e8s tout, on est tous diff\u00e9rents,"}, {"beat": 220, "text": "Des sensibilit\u00e9s \u00e0 fleur de peau, c'est d\u00e9ment,"}, {"beat": 228, "text": "Mais la vie est trop courte pour se chamailler,"}, {"beat": 236, "text": "Soyons libres de rire, de nous amuser."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}