uration": 4}, {"beat": 164, "note": 36, "duration": 4}, {"beat": 168, "note": 38, "duration": 4}, {"beat": 172, "note": 38, "duration": 4}, {"beat": 208, "note": 39, "duration": 4}, {"beat": 212, "note": 36, "duration": 4}, {"beat": 216, "note": 38, "duration": 4}, {"beat": 220, "note": 38, "duration": 4}, {"beat": 224, "note": 39, "duration": 4}, {"beat": 228, "note": 36, "duration": 4}, {"beat": 232, "note": 38, "duration": 4}, {"beat": 236, "note": 38, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 69, "duration": 4}, {"beat": 96, "note": 69, "duration": 4}, {"beat": 176, "note": 69, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 71, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "In my neon outfit, I\u2019m ready to give it all,"}, {"beat": 44, "text": "I bounce like a kangaroo, ready to smash it all,"}, {"beat": 52, "text": "I do pirouettes, acrobatic jumps,"}, {"beat": 60, "text": "In squash, I\u2019m the king, it\u2019s my magical groove."}, {"beat": 68, "text": "When I grab my racket, it sparks,"}, {"beat": 76, "text": "Squash is my passion, it\u2019s the good life, it\u2019s the sky."}, {"beat": 84, "text": "I slide on the court, hitting the ball mid-flight,"}, {"beat": 92, "text": "Squash rocks, it\u2019s my favorite sport, it\u2019s my light."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "With my powerful shots, I defy the laws of gravity,"}, {"beat": 124, "text": "I turn heads, I have style with elegance,"}, {"beat": 132, "text": "I\u2019m the squash stuntman, the virtuoso, the showman,"}, {"beat": 140, "text": "On the court, it\u2019s my show, my performance, my story."}, {"beat": 148, "text": "When I hit the ball, I\u2019m invincible,"}, {"beat": 156, "text": "I overcome all obstacles, I\u2019m irresistible."}, {"beat": 164, "text": "Squash is my drug, my adrenaline, my madness,"}, {"beat": 172, "text": "I\u2019m the star of the court, everyone\u2019s applauding."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "When I leave the court, I\u2019m exhausted but satisfied,"}, {"beat": 220, "text": "Squash is my dose of happiness, my dose of joy."}, {"beat": 228, "text": "I\u2019m a champion at heart, I\u2019m made for this,"}, {"beat": 236, "text": "Squash rocks, there\u2019s nothing better, that\u2019s how it is!"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}