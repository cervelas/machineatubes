e": 24, "duration": 4}, {"beat": 232, "note": 28, "duration": 4}, {"beat": 236, "note": 28, "duration": 4}]}, "toplines": {"type": "notes", "channel": 11, "notes": [{"beat": 16, "note": 86, "duration": 4}, {"beat": 96, "note": 86, "duration": 4}, {"beat": 176, "note": 86, "duration": 4}]}, "voix": {"type": "notes", "channel": 14, "notes": [{"beat": 0, "note": 13, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Prends le basket, le foot ou le tennis,"}, {"beat": 44, "text": "Le mental, c'est l'astuce pour \u00eatre le best,"}, {"beat": 52, "text": "Quand la pression monte, tu dois r\u00e9sister,"}, {"beat": 60, "text": "Reste focus et n'aie pas peur d'essayer."}, {"beat": 68, "text": "Dans le sport, faut pas s'louper,"}, {"beat": 76, "text": "Le mental est tout, faut l'adopter,"}, {"beat": 84, "text": "Avec conviction et d\u00e9termination,"}, {"beat": 92, "text": "On peut tout faire, sans h\u00e9sitation."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Quand tu joues, tu dois \u00eatre comme un lion,"}, {"beat": 124, "text": "Identifie tes peurs et laisse-les sur le perron,"}, {"beat": 132, "text": "Visualise ta victoire, elle est \u00e0 port\u00e9e de main,"}, {"beat": 140, "text": "Avec du courage et de l'audace, tu seras le roi du terrain."}, {"beat": 148, "text": "Le mental c'est la cl\u00e9, la strat\u00e9gie gagnante,"}, {"beat": 156, "text": "Dans nos t\u00eates, on peut tout inventer,"}, {"beat": 164, "text": "Peu importe le challenge, la difficult\u00e9,"}, {"beat": 172, "text": "Avec le mental, on peut tout surmonter."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Dans le sport, faut pas s'louper,"}, {"beat": 220, "text": "Le mental est tout, faut l'adopter,"}, {"beat": 228, "text": "Avec conviction et d\u00e9termination,"}, {"beat": 236, "text": "On peut tout faire, sans h\u00e9sitation."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "