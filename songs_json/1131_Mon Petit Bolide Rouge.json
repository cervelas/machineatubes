, {"beat": 172, "note": 12, "duration": 4}, {"beat": 208, "note": 16, "duration": 4}, {"beat": 212, "note": 16, "duration": 4}, {"beat": 216, "note": 12, "duration": 4}, {"beat": 220, "note": 12, "duration": 4}, {"beat": 224, "note": 16, "duration": 4}, {"beat": 228, "note": 16, "duration": 4}, {"beat": 232, "note": 12, "duration": 4}, {"beat": 236, "note": 12, "duration": 4}]}, "toplines": {"type": "notes", "channel": 9, "notes": [{"beat": 16, "note": 98, "duration": 4}, {"beat": 96, "note": 98, "duration": 4}, {"beat": 176, "note": 98, "duration": 4}]}, "voix": {"type": "notes", "channel": 12, "notes": [{"beat": 0, "note": 83, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "D\u00e9capotable, elle \u00e9tait ma fiert\u00e9,"}, {"beat": 44, "text": "Nous promenant en toute l\u00e9g\u00e8ret\u00e9."}, {"beat": 52, "text": "Le vent dans les cheveux, le soleil sur ma peau,"}, {"beat": 60, "text": "Ma petite voiture, si parfaite pour moi."}, {"beat": 68, "text": "Mon petit bolide rouge, si joli,"}, {"beat": 76, "text": "Nous filions sur les routes sans souci."}, {"beat": 84, "text": "De Neuch\u00e2tel \u00e0 Colombier, que c'\u00e9tait beau,"}, {"beat": 92, "text": "Dans ma petite voiture \u00e9lectrique des ann\u00e9es 90."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Chaque virage, chaque instant unique,"}, {"beat": 124, "text": "Grav\u00e9 dans mon c\u0153ur, source de musique."}, {"beat": 132, "text": "Mais le temps est venu de dire adieu,"}, {"beat": 140, "text": "\u00c0 ma petite voiture, toi qui m'a rendu heureux."}, {"beat": 148, "text": "Mon petit bolide rouge, si joli,"}, {"beat": 156, "text": "Nous filions sur les routes sans souci."}, {"beat": 164, "text": "De Neuch\u00e2tel \u00e0 Colombier, que c'\u00e9tait beau,"}, {"beat": 172, "text": "Dans ma petite voiture \u00e9lectrique des ann\u00e9es 90."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Mon petit bolide rouge, je vais te quitter,"}, {"beat": 220, "text": "Le temps a pass\u00e9, il faut accepter."}, {"beat": 228, "text": "Les souvenirs resteront \u00e0 tout jamais,"}, {"beat": 236, "text": "Dans ma petite voiture, grav\u00e9s \u00e0 jamais."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}