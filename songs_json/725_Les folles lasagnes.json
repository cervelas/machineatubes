, "note": 38, "duration": 4}, {"beat": 232, "note": 39, "duration": 4}, {"beat": 236, "note": 40, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 100, "duration": 4}, {"beat": 96, "note": 100, "duration": 4}, {"beat": 176, "note": 100, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 40, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Avec des courgettes, des poivrons et des champignons,"}, {"beat": 44, "text": "Dans ma po\u00eale qui danse, je pr\u00e9pare cette union,"}, {"beat": 52, "text": "De d\u00e9licats l\u00e9gumes, en lamelles bien dispos\u00e9s,"}, {"beat": 60, "text": "Les lasagnes v\u00e9g\u00e9tariennes sont pr\u00eates \u00e0 \u00eatre d\u00e9gust\u00e9es."}, {"beat": 68, "text": "Oh les folles lasagnes, c'est ma grande passion,"}, {"beat": 76, "text": "Je cuisine tout en dansant dans ma cuisine \u00e0 gogo,"}, {"beat": 84, "text": "Des l\u00e9gumes color\u00e9s, une symphonie de saveurs,"}, {"beat": 92, "text": "Les papilles en f\u00eate, les ventres repus de bonheur."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Avec une b\u00e9chamel l\u00e9g\u00e8re, le tout gratin\u00e9 au four,"}, {"beat": 124, "text": "Un vrai d\u00e9lice en bouche, sans viande mais avec amour,"}, {"beat": 132, "text": "Les convives sont subjugu\u00e9s, ils en redemandent encore,"}, {"beat": 140, "text": "Ces lasagnes v\u00e9g\u00e9tariennes, un festin qui les d\u00e9vore."}, {"beat": 148, "text": "Oh les folles lasagnes, c'est ma grande passion,"}, {"beat": 156, "text": "Je cuisine tout en dansant dans ma cuisine \u00e0 gogo,"}, {"beat": 164, "text": "Des l\u00e9gumes color\u00e9s, une symphonie de saveurs,"}, {"beat": 172, "text": "Les papilles en f\u00eate, les ventres repus de bonheur."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors chantons tous ensemble, c\u00e9l\u00e9brons les lasagnes,"}, {"beat": 220, "text": "Et dansons sans complexe, en \u00e9coutant cette rengaine,"}, {"beat": 228, "text": "Les lasagnes v\u00e9g\u00e9tariennes, un hymne \u00e0 la joie,"}, {"beat": 236, "text": "Dans nos assiettes et nos c\u0153urs, la gourmandise est roi."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}