[ solo ]"}, {"beat": 212, "text": "Ces petites machines, c'est mon r\u00e9veil en musique,"}, {"beat": 220, "text": "Elles m'accompagnent partout, magiques et ludiques,"}, {"beat": 228, "text": "Que serait ma vie sans leur dext\u00e9rit\u00e9 technologique,"}, {"beat": 236, "text": "Vive les gadgets, c'est ma drogue sans panique."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}