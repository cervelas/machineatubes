 36, "duration": 4}, {"beat": 220, "note": 36, "duration": 4}, {"beat": 224, "note": 38, "duration": 4}, {"beat": 228, "note": 38, "duration": 4}, {"beat": 232, "note": 36, "duration": 4}, {"beat": 236, "note": 36, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 32, "duration": 4}, {"beat": 96, "note": 32, "duration": 4}, {"beat": 176, "note": 32, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 36, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Je m'\u00e9tais promis d'arr\u00eater, mais quelle ironie"}, {"beat": 44, "text": "En une demi-heure, tout est parti en fum\u00e9e"}, {"beat": 52, "text": "J'ai compt\u00e9 les clopes, en esp\u00e9rant que \u00e7a finisse"}, {"beat": 60, "text": "Mais j'ai craqu\u00e9, j'ai tout grill\u00e9, quelle b\u00eatise"}, {"beat": 68, "text": "J'ai fum\u00e9 mon dernier paquet en 30 minutes"}, {"beat": 76, "text": "\u00c7a faisait tellement dr\u00f4le, j'en ai perdu l'\u00e9quilibre"}, {"beat": 84, "text": "La fum\u00e9e qui montait, j'ai cru voir des licornes"}, {"beat": 92, "text": "La f\u00eate des bouff\u00e9es, ouais j'\u00e9tais raide comme un tr\u00f4ne"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Les copains me regardaient, ahuris et perplexes"}, {"beat": 124, "text": "Ils m'ont dit : \"T'as tout p\u00e9t\u00e9, toi t'es vraiment hex\""}, {"beat": 132, "text": "Je leur ai r\u00e9pondu, sourire aux l\u00e8vres crisp\u00e9es"}, {"beat": 140, "text": "\"C'est qu'une f\u00eate \u00e9clair, il fallait bien tester\""}, {"beat": 148, "text": "J'ai fum\u00e9 mon dernier paquet en 30 minutes"}, {"beat": 156, "text": "\u00c7a faisait tellement dr\u00f4le, j'en ai perdu l'\u00e9quilibre"}, {"beat": 164, "text": "La fum\u00e9e qui montait, j'ai cru voir des licornes"}, {"beat": 172, "text": "La f\u00eate des bouff\u00e9es, ouais j'\u00e9tais raide comme un tr\u00f4ne"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Et maintenant je promets, bondissant dans les airs,"}, {"beat": 220, "text": "De ne plus jamais fumer autant d'un seul coup, j'en ai ma claque"}, {"beat": 228, "text": "Mon dernier paquet fut ma derni\u00e8re extravagance"}, {"beat": 236, "text": "La f\u00eate des bouff\u00e9es, c'\u00e9tait ma derni\u00e8re danse"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}