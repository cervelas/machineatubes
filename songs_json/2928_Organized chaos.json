": 208, "note": 38, "duration": 4}, {"beat": 212, "note": 38, "duration": 4}, {"beat": 216, "note": 40, "duration": 4}, {"beat": 220, "note": 40, "duration": 4}, {"beat": 224, "note": 38, "duration": 4}, {"beat": 228, "note": 38, "duration": 4}, {"beat": 232, "note": 40, "duration": 4}, {"beat": 236, "note": 40, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 61, "duration": 4}, {"beat": 96, "note": 61, "duration": 4}, {"beat": 176, "note": 61, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 100, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "In the morning I rise, everything\u2019s a mess,"}, {"beat": 44, "text": "Socks in a jumble, still I laugh, I confess,"}, {"beat": 52, "text": "Car keys lost again, as usual,"}, {"beat": 60, "text": "But in this chaos, I always find my route, so crucial."}, {"beat": 68, "text": "In my life, it\u2019s organized chaos,"}, {"beat": 76, "text": "I\u2019m disorganized, but it makes me toss,"}, {"beat": 84, "text": "Things pile up, it's a real clutter scene,"}, {"beat": 92, "text": "But I always find what I need, not too mean!"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "On my desk, papers are all around,"}, {"beat": 124, "text": "But I know exactly where every thought is found,"}, {"beat": 132, "text": "When I create, it\u2019s a real disaster,"}, {"beat": 140, "text": "But it sparks my inspiration, like a master."}, {"beat": 148, "text": "I\u2019m a perfectionist in my own way,"}, {"beat": 156, "text": "Even if everything\u2019s in disarray, I see the play,"}, {"beat": 164, "text": "My friends say I should tidy up now and then,"}, {"beat": 172, "text": "But I love seeing my life as a madman\u2019s art, amen."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "So I\u2019ll keep being messy, wild and free,"}, {"beat": 220, "text": "A crazy artist, never tamed, you see,"}, {"beat": 228, "text": "In this chaos, I find my liberty,"}, {"beat": 236, "text": "And it\u2019s in the clutter where I\u2019m truly happy!"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}