: 212, "note": 14, "duration": 4}, {"beat": 216, "note": 16, "duration": 4}, {"beat": 220, "note": 16, "duration": 4}, {"beat": 224, "note": 14, "duration": 4}, {"beat": 228, "note": 14, "duration": 4}, {"beat": 232, "note": 16, "duration": 4}, {"beat": 236, "note": 16, "duration": 4}]}, "toplines": {"type": "notes", "channel": 9, "notes": [{"beat": 16, "note": 74, "duration": 4}, {"beat": 96, "note": 74, "duration": 4}, {"beat": 176, "note": 74, "duration": 4}]}, "voix": {"type": "notes", "channel": 12, "notes": [{"beat": 0, "note": 44, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Assis au comptoir, je bois ma m\u00e9lancolie,"}, {"beat": 44, "text": "Les verres s'accumulent, en \u00e9cho de mon d\u00e9pit,"}, {"beat": 52, "text": "Les rires fusent, mais mon c\u0153ur perd son \u00e9lan,"}, {"beat": 60, "text": "Je cherche l'inspiration, ce soir, en vain."}, {"beat": 68, "text": "Un soir au bistrot, la vie tristounette,"}, {"beat": 76, "text": "Des rires \u00e9gar\u00e9s et des verres en f\u00eate,"}, {"beat": 84, "text": "Dans ce lieu tamis\u00e9, aux \u00e9clats des regards,"}, {"beat": 92, "text": "C'est l\u00e0 que je trouve ma chanson, mon art."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Les serveurs press\u00e9s, les amours d\u00e9laiss\u00e9es,"}, {"beat": 124, "text": "Les regards fuyants, dissimul\u00e9s sous l'exc\u00e8s,"}, {"beat": 132, "text": "Mais moi, je r\u00eave d'un bonheur d\u00e9cal\u00e9,"}, {"beat": 140, "text": "Dans ce bistrot, o\u00f9 tout est permis, tout est \"zigzaguant\"."}, {"beat": 148, "text": "Un soir au bistrot, l'esprit qui se d\u00e9m\u00e8ne,"}, {"beat": 156, "text": "Les ivrognes chancelants, la vie qui se d\u00e9cha\u00eene,"}, {"beat": 164, "text": "Dans ces murs anonymes, j'y cherche un chemin,"}, {"beat": 172, "text": "Un instant de vraie folie, un doux refrain."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Un soir au bistrot, l'\u00e2me un peu frivole,"}, {"beat": 220, "text": "Le vin qui coule \u00e0 flots, l'espoir qui s'envole,"}, {"beat": 228, "text": "Dans ces conversations l\u00e9g\u00e8res, mon c\u0153ur s'\u00e9veille,"}, {"beat": 236, "text": "Je chante ma tristesse, ma joie sans pareille."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}