 "note": 27, "duration": 4}, {"beat": 208, "note": 28, "duration": 4}, {"beat": 212, "note": 28, "duration": 4}, {"beat": 216, "note": 27, "duration": 4}, {"beat": 220, "note": 27, "duration": 4}, {"beat": 224, "note": 28, "duration": 4}, {"beat": 228, "note": 28, "duration": 4}, {"beat": 232, "note": 27, "duration": 4}, {"beat": 236, "note": 27, "duration": 4}]}, "toplines": {"type": "notes", "channel": 11, "notes": [{"beat": 16, "note": 81, "duration": 4}, {"beat": 96, "note": 81, "duration": 4}, {"beat": 176, "note": 81, "duration": 4}]}, "voix": {"type": "notes", "channel": 14, "notes": [{"beat": 0, "note": 45, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "I'm a pop singer, a little wild and free,"}, {"beat": 44, "text": "Always ready to make you laugh, that's me."}, {"beat": 52, "text": "Critics and gossip? I don\u2019t care at all,"}, {"beat": 60, "text": "I\u2019d rather spread joy, that\u2019s my call."}, {"beat": 68, "text": "Controversy doesn\u2019t interest me,"}, {"beat": 76, "text": "I just want to sing, that\u2019s the key."}, {"beat": 84, "text": "Forget the squabbles, let\u2019s set them free,"}, {"beat": 92, "text": "Let our music shine, let it be."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "My audience, you\u2019re my one true delight,"}, {"beat": 124, "text": "I want to make you dance, day and night."}, {"beat": 132, "text": "Discords and debates, such a waste,"}, {"beat": 140, "text": "I\u2019d rather rhyme love and music with taste."}, {"beat": 148, "text": "Controversy doesn\u2019t interest me,"}, {"beat": 156, "text": "I just want to sing, that\u2019s the key."}, {"beat": 164, "text": "Forget the squabbles, let\u2019s set them free,"}, {"beat": 172, "text": "Let our music shine, let it be."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Come on, everyone, let\u2019s raise our hands,"}, {"beat": 220, "text": "Sing non-stop, let the echoes expand."}, {"beat": 228, "text": "Controversy has no place in our land,"}, {"beat": 236, "text": "Long live the music, long live the joy, that\u2019s grand!"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}