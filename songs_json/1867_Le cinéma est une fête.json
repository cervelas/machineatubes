, "duration": 4}, {"beat": 232, "note": 24, "duration": 4}, {"beat": 236, "note": 28, "duration": 4}]}, "toplines": {"type": "notes", "channel": 11, "notes": [{"beat": 16, "note": 30, "duration": 4}, {"beat": 96, "note": 30, "duration": 4}, {"beat": 176, "note": 30, "duration": 4}]}, "voix": {"type": "notes", "channel": 14, "notes": [{"beat": 0, "note": 60, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Dans un monde de bobines et de pellicules,"}, {"beat": 44, "text": "Un cin\u00e9phile en moi se d\u00e9ambule."}, {"beat": 52, "text": "Les salles obscures sont mon terrain de jeu,"}, {"beat": 60, "text": "O\u00f9 les films d\u00e9filent, m'emportent loin des ennuis."}, {"beat": 68, "text": "Je suis cin\u00e9phile, c'est ma passion,"}, {"beat": 76, "text": "Rire, pleurer devant l'\u00e9motion."}, {"beat": 84, "text": "Les acteurs, les sc\u00e9narios, m'enchantent,"}, {"beat": 92, "text": "Le cin\u00e9ma, une f\u00eate sans fin qui danse."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Je m'installe, le popcorn \u00e0 la main,"}, {"beat": 124, "text": "La lumi\u00e8re s'\u00e9teint, l'\u00e9cran s'anime."}, {"beat": 132, "text": "Du rire de Chaplin \u00e0 l'action de Stallone,"}, {"beat": 140, "text": "Je vis mille vies, j'en redemande encore et encore."}, {"beat": 148, "text": "Je suis cin\u00e9phile, c'est ma passion,"}, {"beat": 156, "text": "Rire, pleurer devant l'\u00e9motion."}, {"beat": 164, "text": "Les acteurs, les sc\u00e9narios, m'enchantent,"}, {"beat": 172, "text": "Le cin\u00e9ma, une f\u00eate sans fin qui danse."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Je suis cin\u00e9phile, c'est ma passion,"}, {"beat": 220, "text": "Rire, pleurer devant l'\u00e9motion."}, {"beat": 228, "text": "Les acteurs, les sc\u00e9narios, m'enchantent,"}, {"beat": 236, "text": "Le cin\u00e9ma, une f\u00eate sans fin qui danse."}, {"beat": 244, "text": "[o