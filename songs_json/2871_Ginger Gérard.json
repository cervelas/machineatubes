 212, "note": 27, "duration": 4}, {"beat": 216, "note": 25, "duration": 4}, {"beat": 220, "note": 25, "duration": 4}, {"beat": 224, "note": 24, "duration": 4}, {"beat": 228, "note": 27, "duration": 4}, {"beat": 232, "note": 25, "duration": 4}, {"beat": 236, "note": 25, "duration": 4}]}, "toplines": {"type": "notes", "channel": 11, "notes": [{"beat": 16, "note": 91, "duration": 4}, {"beat": 96, "note": 91, "duration": 4}, {"beat": 176, "note": 91, "duration": 4}]}, "voix": {"type": "notes", "channel": 14, "notes": [{"beat": 0, "note": 50, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "In a small seaside village, you\u2019ll find,"}, {"beat": 44, "text": "The funniest character of all time,"}, {"beat": 52, "text": "His name is G\u00e9rard, the humor king,"}, {"beat": 60, "text": "And he loves his ginger brew, let me sing."}, {"beat": 68, "text": "Ginger G\u00e9rard, the king of tenderness,"}, {"beat": 76, "text": "In his cup, there's liqueur and distress,"}, {"beat": 84, "text": "Ginger G\u00e9rard, with a heart always fair,"}, {"beat": 92, "text": "He makes the crowd sing with his sweet flair."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "With a smile, he lights up the stage,"}, {"beat": 124, "text": "His ginger is magic, I tell you this with sage,"}, {"beat": 132, "text": "He makes the big ones laugh, he makes the small ones cheer,"}, {"beat": 140, "text": "And everyone dances to his melody, sincere."}, {"beat": 148, "text": "Ginger G\u00e9rard, funny and sensual,"}, {"beat": 156, "text": "His ginger bewitches, his humor a call so natural,"}, {"beat": 164, "text": "Ginger G\u00e9rard, the stress antidote,"}, {"beat": 172, "text": "He makes hearts dance, with his natural glee afloat."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Ginger G\u00e9rard, the star of laughter\u2019s light,"}, {"beat": 220, "text": "The ginger liqueur turns him to delight,"}, {"beat": 228, "text": "Ginger G\u00e9rard, always ready to smile,"}, {"beat": 236, "text": "He sets the nights ablaze, with jokes that beguile."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}