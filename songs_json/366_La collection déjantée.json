{"beat": 208, "note": 25, "duration": 4}, {"beat": 212, "note": 24, "duration": 4}, {"beat": 216, "note": 27, "duration": 4}, {"beat": 220, "note": 29, "duration": 4}, {"beat": 224, "note": 25, "duration": 4}, {"beat": 228, "note": 24, "duration": 4}, {"beat": 232, "note": 27, "duration": 4}, {"beat": 236, "note": 29, "duration": 4}]}, "toplines": {"type": "notes", "channel": 11, "notes": [{"beat": 16, "note": 108, "duration": 4}, {"beat": 96, "note": 108, "duration": 4}, {"beat": 176, "note": 108, "duration": 4}]}, "voix": {"type": "notes", "channel": 14, "notes": [{"beat": 0, "note": 16, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Dans ma chambre, c'est un vrai bazar,"}, {"beat": 44, "text": "Des bibelots partout, c'est un cauchemar."}, {"beat": 52, "text": "Des canards en plastique jusqu'au plafond,"}, {"beat": 60, "text": "Des cactus en peluche qui dansent \u00e0 foison."}, {"beat": 68, "text": "J'accumule tout ce qui me pla\u00eet,"}, {"beat": 76, "text": "Une collection qui d\u00e9lire en secret."}, {"beat": 84, "text": "Des objets farfelus, sans int\u00e9r\u00eat,"}, {"beat": 92, "text": "Mais j'en suis fier, c'est ma libert\u00e9."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Des chapeaux de cow-boy et des maracas,"}, {"beat": 124, "text": "Des coquillages ramass\u00e9s sur les plages du Bahamas."}, {"beat": 132, "text": "Des gadgets \u00e9lectroniques qui ne fonctionnent plus,"}, {"beat": 140, "text": "Mais je les conserve, c'est mon unique refuge."}, {"beat": 148, "text": "J'accumule tout ce qui me pla\u00eet,"}, {"beat": 156, "text": "Une collection qui d\u00e9lire en secret."}, {"beat": 164, "text": "Des objets farfelus, sans int\u00e9r\u00eat,"}, {"beat": 172, "text": "Mais j'en suis fier, c'est ma libert\u00e9."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors venez, venez dans mon univers d\u00e9jant\u00e9,"}, {"beat": 220, "text": "O\u00f9 chaque objet est un sourire \u00e0 d\u00e9clencher."}, {"beat": 228, "text": "La vie est trop courte pour ne pas s'amuser,"}, {"beat": 236, "text": "Avec ma collection, je trouve mon bonheur \u00e0 chaque pas."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}