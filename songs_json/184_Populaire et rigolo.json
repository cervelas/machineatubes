}, {"beat": 220, "note": 25, "duration": 4}, {"beat": 224, "note": 29, "duration": 4}, {"beat": 228, "note": 26, "duration": 4}, {"beat": 232, "note": 25, "duration": 4}, {"beat": 236, "note": 25, "duration": 4}]}, "toplines": {"type": "notes", "channel": 11, "notes": [{"beat": 16, "note": 40, "duration": 4}, {"beat": 96, "note": 40, "duration": 4}, {"beat": 176, "note": 40, "duration": 4}]}, "voix": {"type": "notes", "channel": 14, "notes": [{"beat": 0, "note": 20, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Dans ma vie quotidienne, je suis plut\u00f4t banal,"}, {"beat": 44, "text": "Mais avec ma musique, je brille comme un cristal,"}, {"beat": 52, "text": "J'encha\u00eene les paroles dr\u00f4les, les m\u00e9lodies entrainantes,"}, {"beat": 60, "text": "Le public ne peut s'emp\u00eacher de sourire et de danser."}, {"beat": 68, "text": "Je veux \u00eatre populaire, le roi de la sc\u00e8ne,"}, {"beat": 76, "text": "Faire danser les foules et cr\u00e9er un engouement,"}, {"beat": 84, "text": "Avec mes chansons rigolotes, je vais les amener loin,"}, {"beat": 92, "text": "Sous les projecteurs, je suis le num\u00e9ro un sur le podium."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "J'\u00e9cris mes paroles avec humour et malice,"}, {"beat": 124, "text": "Je joue avec les mots, les rimes et les ficelles,"}, {"beat": 132, "text": "Sur sc\u00e8ne, je fais le pitre, je m'amuse sans malice,"}, {"beat": 140, "text": "Et le public me suit, embarqu\u00e9 dans ma folie belle."}, {"beat": 148, "text": "Je suis le clown de la chanson, le farceur de la sc\u00e8ne,"}, {"beat": 156, "text": "Tout le monde a besoin de ma bonne humeur, de mon venin,"}, {"beat": 164, "text": "M\u00eame dans les jours les plus sombres, je suis l\u00e0 pour illuminer,"}, {"beat": 172, "text": "Avec mes chansons rigolotes, je vais tous vous charmer."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, 