 4}, {"beat": 220, "note": 14, "duration": 4}, {"beat": 224, "note": 14, "duration": 4}, {"beat": 228, "note": 15, "duration": 4}, {"beat": 232, "note": 16, "duration": 4}, {"beat": 236, "note": 14, "duration": 4}]}, "toplines": {"type": "notes", "channel": 9, "notes": [{"beat": 16, "note": 50, "duration": 4}, {"beat": 96, "note": 50, "duration": 4}, {"beat": 176, "note": 50, "duration": 4}]}, "voix": {"type": "notes", "channel": 12, "notes": [{"beat": 0, "note": 49, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "J'ai des id\u00e9es r\u00e9flexes, oh l\u00e0 l\u00e0"}, {"beat": 44, "text": "Dans ma t\u00eate qui fait la java"}, {"beat": 52, "text": "Je r\u00e9fl\u00e9chis \u00e0 tout, tout le temps"}, {"beat": 60, "text": "Mais mes pens\u00e9es me font tourner en rond"}, {"beat": 68, "text": "Les id\u00e9es r\u00e9flexes, \u00e7a me rend dingue"}, {"beat": 76, "text": "Je suis coinc\u00e9 dans mon propre brouillard"}, {"beat": 84, "text": "Mes neurones font des galipettes folles"}, {"beat": 92, "text": "Mais ma vie s'embrouille, c'est du grand n'importe quoi"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Je passe mes jours \u00e0 penser"}, {"beat": 124, "text": "\u00c0 des trucs qui ne servent \u00e0 rien, je l'avoue"}, {"beat": 132, "text": "Je pense \u00e0 la couleur de mes chaussettes"}, {"beat": 140, "text": "Et \u00e0 la somme des angles d'un triangle isoc\u00e8le"}, {"beat": 148, "text": "Les id\u00e9es r\u00e9flexes, \u00e7a me rend fou"}, {"beat": 156, "text": "Je suis prisonnier de ma propre t\u00eate"}, {"beat": 164, "text": "J'en ai marre de ces pens\u00e9es qui tournent en boucle"}, {"beat": 172, "text": "\u00c7a m'\u00e9puise, \u00e7a me rend compl\u00e8tement marteau"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Les id\u00e9es r\u00e9flexes, \u00e7a me fait rigoler"}, {"beat": 220, "text": "M\u00eame si \u00e7a me rend un peu cingl\u00e9"}, {"beat": 228, "text": "Je pr\u00e9f\u00e8re en rire plut\u00f4t qu'en pleurer"}, {"beat": 236, "text": "C'est ma fa\u00e7on de m'en sortir, de tout d\u00e9rider"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}