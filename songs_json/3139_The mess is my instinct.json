ration": 4}, {"beat": 172, "note": 41, "duration": 4}, {"beat": 208, "note": 37, "duration": 4}, {"beat": 212, "note": 37, "duration": 4}, {"beat": 216, "note": 41, "duration": 4}, {"beat": 220, "note": 41, "duration": 4}, {"beat": 224, "note": 37, "duration": 4}, {"beat": 228, "note": 37, "duration": 4}, {"beat": 232, "note": 41, "duration": 4}, {"beat": 236, "note": 41, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 79, "duration": 4}, {"beat": 96, "note": 79, "duration": 4}, {"beat": 176, "note": 79, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 61, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "I\u2019m a bit lazy, it\u2019s true,"}, {"beat": 44, "text": "In my mind, everything\u2019s in perfect disarray too."}, {"beat": 52, "text": "But in the movies, oh, it\u2019s all arranged,"}, {"beat": 60, "text": "I\u2019m an expert, creatively deranged."}, {"beat": 68, "text": "I only tidy things up in films,"}, {"beat": 76, "text": "In my life, chaos is my instinct's whims."}, {"beat": 84, "text": "Objects fly, clothes get mixed up too,"}, {"beat": 92, "text": "In my world, disorder\u2019s a challenge I pursue."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "My socks don\u2019t have their matches,"}, {"beat": 124, "text": "My keys hide in the news clippings' batches."}, {"beat": 132, "text": "But in the films, it's always pristine,"}, {"beat": 140, "text": "I pretend, and it\u2019s quite the scene."}, {"beat": 148, "text": "I only tidy things up in films,"}, {"beat": 156, "text": "In my life, chaos reigns supreme."}, {"beat": 164, "text": "Papers fly, glasses shatter with grace,"}, {"beat": 172, "text": "In my universe, nothing\u2019s in its place."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "I\u2019m an artist of the mess,"}, {"beat": 220, "text": "My disorder's my best success."}, {"beat": 228, "text": "So I leave everything in disarray,"}, {"beat": 236, "text": "Because in movies, all is perfect, they say."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}