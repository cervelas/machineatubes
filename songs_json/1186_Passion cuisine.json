ote": 40, "duration": 4}, {"beat": 224, "note": 37, "duration": 4}, {"beat": 228, "note": 37, "duration": 4}, {"beat": 232, "note": 40, "duration": 4}, {"beat": 236, "note": 40, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 5, "duration": 4}, {"beat": 96, "note": 5, "duration": 4}, {"beat": 176, "note": 5, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 19, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Laisse-moi te pr\u00e9senter cette chanson,"}, {"beat": 44, "text": "Un hymne \u00e0 cuisiner sans mod\u00e9ration,"}, {"beat": 52, "text": "Dans la cuisine, on se lib\u00e8re, on s'amuse,"}, {"beat": 60, "text": "On se r\u00e9gale, et c'est la vie qu'on refuse."}, {"beat": 68, "text": "Cuisiner \u00e7a fait du bien \u00e0 la t\u00eate,"}, {"beat": 76, "text": "Dans la po\u00eale, la joie se fait na\u00eetre,"}, {"beat": 84, "text": "On m\u00e9lange les ingr\u00e9dients pour s'amuser,"}, {"beat": 92, "text": "La recette du bonheur, on va la partager."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Dans ma cuisine, je suis le roi du cassoulet,"}, {"beat": 124, "text": "Je fais sauter les l\u00e9gumes, c'est mon secret,"}, {"beat": 132, "text": "Le poivre, le sel, c'est ma danse endiabl\u00e9e,"}, {"beat": 140, "text": "Et quand mes amis go\u00fbtent, ils sont \u00e9merveill\u00e9s."}, {"beat": 148, "text": "Cuisiner \u00e7a fait du bien \u00e0 la t\u00eate,"}, {"beat": 156, "text": "On p\u00e9tille sous la hotte, on se pr\u00eate,"}, {"beat": 164, "text": "Aux \u00e9clats de rire, aux odeurs qui se m\u00e9langent,"}, {"beat": 172, "text": "Dans ma po\u00eale magique, les sourires se d\u00e9gagent."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Cuisiner \u00e7a fait du bien \u00e0 la t\u00eate,"}, {"beat": 220, "text": "On p\u00e9tille sous la hotte, on se pr\u00eate,"}, {"beat": 228, "text": "Aux \u00e9clats de rire, aux odeurs qui se m\u00e9langent,"}, {"beat": 236, "text": "Dans ma po\u00eale magique, les sourires se d\u00e9gagent."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}