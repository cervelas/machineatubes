"beat": 212, "note": 13, "duration": 4}, {"beat": 216, "note": 12, "duration": 4}, {"beat": 220, "note": 12, "duration": 4}, {"beat": 224, "note": 13, "duration": 4}, {"beat": 228, "note": 13, "duration": 4}, {"beat": 232, "note": 12, "duration": 4}, {"beat": 236, "note": 12, "duration": 4}]}, "toplines": {"type": "notes", "channel": 9, "notes": [{"beat": 16, "note": 14, "duration": 4}, {"beat": 96, "note": 14, "duration": 4}, {"beat": 176, "note": 14, "duration": 4}]}, "voix": {"type": "notes", "channel": 12, "notes": [{"beat": 0, "note": 60, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "J'\u00e9tais triste et perdu dans ma vie,"}, {"beat": 44, "text": "Un c\u0153ur bris\u00e9, seul dans l'ennui."}, {"beat": 52, "text": "Mais j'ai d\u00e9cid\u00e9 de sourire, de m'amuser,"}, {"beat": 60, "text": "Pourquoi se morfondre, autant en rire !"}, {"beat": 68, "text": "Si tu l'assumes, ce n'est plus du mauvais go\u00fbt,"}, {"beat": 76, "text": "Oublions les chagrins, allons-y, soyons fous !"}, {"beat": 84, "text": "Dansons et chantons, faisons la f\u00eate sans fin,"}, {"beat": 92, "text": "Car c'est en riant qu'on trouve le bonheur, enfin !"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Les gens me regardent bizarrement,"}, {"beat": 124, "text": "Mais je m'en fiche, je suis diff\u00e9rent."}, {"beat": 132, "text": "J'ose \u00eatre moi, avec tout mon grain de folie,"}, {"beat": 140, "text": "La vie est trop courte, autant en profiter !"}, {"beat": 148, "text": "Si tu l'assumes, ce n'est plus du mauvais go\u00fbt,"}, {"beat": 156, "text": "Oublions les chagrins, allons-y, soyons fous !"}, {"beat": 164, "text": "Dansons et chantons, faisons la f\u00eate sans fin,"}, {"beat": 172, "text": "Car c'est en riant qu'on trouve le bonheur, enfin !"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Si tu l'assumes, ce n'est plus du mauvais go\u00fbt,"}, {"beat": 220, "text": "Oublions les chagrins, allons-y, soyons fous !"}, {"beat": 228, "text": "Dansons et chantons, faisons la f\u00eate sans fin,"}, {"beat": 236, "text": "Car c'est en riant qu'on trouve le bonheur, enfin !"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}