, "duration": 4}, {"beat": 228, "note": 38, "duration": 4}, {"beat": 232, "note": 41, "duration": 4}, {"beat": 236, "note": 40, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 20, "duration": 4}, {"beat": 96, "note": 20, "duration": 4}, {"beat": 176, "note": 20, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 38, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Joe Dassin, un artiste \u00e0 part enti\u00e8re"}, {"beat": 44, "text": "Ses m\u00e9lodies l\u00e9g\u00e8res, font danser la Terre"}, {"beat": 52, "text": "Des refrains qui swinguent, qui donnent envie de bouger"}, {"beat": 60, "text": "Joe Dassin, le roi du pop, personne ne peut nier"}, {"beat": 68, "text": "J'adore Joe Dassin, oui c'est ma passion"}, {"beat": 76, "text": "Ses chansons sont divines, j'en ai la frisson"}, {"beat": 84, "text": "Avec sa voix suave, il m'envo\u00fbte chaque saison"}, {"beat": 92, "text": "Oh Joe Dassin, tu es ma providence !"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Ses paroles remplies de malice et d'humour"}, {"beat": 124, "text": "Joe Dassin, un conteur qui sait charmer son public"}, {"beat": 132, "text": "Dans ses chansons, il raconte des histoires d'amour"}, {"beat": 140, "text": "Qui nous font sourire, rire et parfois m\u00eame ludique"}, {"beat": 148, "text": "J'adore Joe Dassin, oui c'est ma passion"}, {"beat": 156, "text": "Ses chansons sont divines, j'en ai la frisson"}, {"beat": 164, "text": "Avec sa voix suave, il m'envo\u00fbte chaque saison"}, {"beat": 172, "text": "Oh Joe Dassin, tu es ma providence !"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Joe Dassin, merci pour tes m\u00e9lodies entra\u00eenantes"}, {"beat": 220, "text": "\u00c0 travers ta musique, tu mets du sourire dans nos vies"}, {"beat": 228, "text": "Tu es et tu resteras toujours mon idole enchanteresse"}, {"beat": 236, "text": "Joe Dassin, l'artiste qui met la France en liesse !"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}