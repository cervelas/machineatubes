08, "note": 39, "duration": 4}, {"beat": 212, "note": 41, "duration": 4}, {"beat": 216, "note": 38, "duration": 4}, {"beat": 220, "note": 38, "duration": 4}, {"beat": 224, "note": 39, "duration": 4}, {"beat": 228, "note": 41, "duration": 4}, {"beat": 232, "note": 38, "duration": 4}, {"beat": 236, "note": 38, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 68, "duration": 4}, {"beat": 96, "note": 68, "duration": 4}, {"beat": 176, "note": 68, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 82, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Assis dans mon fauteuil, \u00e0 penser sans fin,"}, {"beat": 44, "text": "Les id\u00e9es r\u00e9flexes, \u00e7a n'a pas de fin."}, {"beat": 52, "text": "Une brume s'installe, dans mon cerveau en vrac,"}, {"beat": 60, "text": "Je cherche la solution, mais je ne la trouve pas."}, {"beat": 68, "text": "Oh les id\u00e9es r\u00e9flexes, dans ma t\u00eate qui s'amusent,"}, {"beat": 76, "text": "Elles se font la course, telle une dr\u00f4le de ruse."}, {"beat": 84, "text": "Des pens\u00e9es tourbillonnent, dans mon esprit confus,"}, {"beat": 92, "text": "Les id\u00e9es r\u00e9flexes, \u00e7a me rend un peu f(l)ou !"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Quand je dors la nuit, tourment\u00e9 par le doute,"}, {"beat": 124, "text": "Les id\u00e9es r\u00e9flexes me tiennent en d\u00e9route."}, {"beat": 132, "text": "Je me r\u00e9veille en sursaut, avec des questions plein la t\u00eate,"}, {"beat": 140, "text": "Les id\u00e9es r\u00e9flexes, jamais elles ne s'arr\u00eatent."}, {"beat": 148, "text": "Oh les id\u00e9es r\u00e9flexes, dans ma t\u00eate qui s'amusent,"}, {"beat": 156, "text": "Elles se font la course, telle une dr\u00f4le de ruse."}, {"beat": 164, "text": "Des pens\u00e9es tourbillonnent, dans mon esprit confus,"}, {"beat": 172, "text": "Les id\u00e9es r\u00e9flexes, \u00e7a me rend un peu f(l)ou !"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors je ris de moi-m\u00eame, de ces id\u00e9es farfelues,"}, {"beat": 220, "text": "Je m'amuse avec mes pens\u00e9es, m\u00eame si c'est un peu hasardeux."}, {"beat": 228, "text": "Car apr\u00e8s tout, dans ce monde si s\u00e9rieux,"}, {"beat": 236, "text": "Les id\u00e9es r\u00e9flexes sont mon petit jeu !"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}