note": 38, "duration": 4}, {"beat": 232, "note": 39, "duration": 4}, {"beat": 236, "note": 39, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 9, "duration": 4}, {"beat": 96, "note": 9, "duration": 4}, {"beat": 176, "note": 9, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 30, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Les chaussettes m\u00e9lang\u00e9es, les assiettes \u00e9br\u00e9ch\u00e9es,"}, {"beat": 44, "text": "On s'en moque, \u00e7a nous fait rire aux \u00e9clats,"}, {"beat": 52, "text": "Les papiers froiss\u00e9s, les meubles d\u00e9plac\u00e9s,"}, {"beat": 60, "text": "C'est \u00e7a la vie, un joyeux et fou bazar!"}, {"beat": 68, "text": "Fous le bordel dans ta maison,"}, {"beat": 76, "text": "Oublie les r\u00e8gles et les le\u00e7ons,"}, {"beat": 84, "text": "Laisse-toi aller, fais ce qu'il te pla\u00eet,"}, {"beat": 92, "text": "La folie c'est la cl\u00e9 du succ\u00e8s parfait!"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Les cheveux en pagaille, le maquillage d\u00e9goulinant,"}, {"beat": 124, "text": "On s'en fiche, on est libres et d\u00e9lirants,"}, {"beat": 132, "text": "Les pantalons trou\u00e9s, les chaussures d\u00e9lac\u00e9es,"}, {"beat": 140, "text": "C'est notre style, tout en d\u00e9sordre assum\u00e9!"}, {"beat": 148, "text": "Fous le bordel partout o\u00f9 tu vas,"}, {"beat": 156, "text": "Brise les conventions, ne t'en fais pas,"}, {"beat": 164, "text": "Danse sur les tables, chante \u00e0 tue-t\u00eate,"}, {"beat": 172, "text": "Laisse le chaos r\u00e9gner, c'est une f\u00eate!"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Fous le bordel dans ta maison,"}, {"beat": 220, "text": "Oublie les r\u00e8gles et les le\u00e7ons,"}, {"beat": 228, "text": "Laisse-toi aller, fais ce qu'il te pla\u00eet,"}, {"beat": 236, "text": "La folie c'est la cl\u00e9 du succ\u00e8s parfait!"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}