at": 220, "note": 37, "duration": 4}, {"beat": 224, "note": 36, "duration": 4}, {"beat": 228, "note": 39, "duration": 4}, {"beat": 232, "note": 38, "duration": 4}, {"beat": 236, "note": 37, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 18, "duration": 4}, {"beat": 96, "note": 18, "duration": 4}, {"beat": 176, "note": 18, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 24, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "J'ai plein de blocs-notes, des petits, des grands"}, {"beat": 44, "text": "Ils sont color\u00e9s, et \u00e7a c'est encourageant"}, {"beat": 52, "text": "Je les emporte partout, dans mon sac \u00e0 dos"}, {"beat": 60, "text": "Pour \u00e9crire mes id\u00e9es, c'est incroyable, c'est beau"}, {"beat": 68, "text": "Mais parfois je m'en sors pas, j'ai l'inspiration qui coince"}, {"beat": 76, "text": "Je cherche mes mots, je griffonne des croquis"}, {"beat": 84, "text": "Mais quand je les ai trouv\u00e9s, oh l\u00e0 l\u00e0, quel bonheur immense"}, {"beat": 92, "text": "La magie des blocs-notes, \u00e7a me rend si ravi"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Il y a des blocs-notes avec des spirales"}, {"beat": 124, "text": "Je les tourne en rond, je me sens royale"}, {"beat": 132, "text": "Les pages lign\u00e9es, \u00e7a me fascine, \u00e7a m'inspire"}, {"beat": 140, "text": "J'\u00e9cris mes histoires, mes r\u00eaves, mes d\u00e9lires"}, {"beat": 148, "text": "Mais parfois je m'en sors pas, j'ai l'inspiration qui coince"}, {"beat": 156, "text": "Je cherche mes mots, je griffonne des croquis"}, {"beat": 164, "text": "Mais quand je les ai trouv\u00e9s, oh l\u00e0 l\u00e0, quel bonheur immense"}, {"beat": 172, "text": "La magie des blocs-notes, \u00e7a me rend si ravi"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors si tu veux des id\u00e9es, si tu veux cr\u00e9er"}, {"beat": 220, "text": "Prends un bloc-notes et laisse-toi emporter"}, {"beat": 228, "text": "Laisse parler ton c\u0153ur, laisse parler ton esprit"}, {"beat": 236, "text": "La magie des blocs-notes, c'est la cl\u00e9 de l'\u00e9crit."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}