 "note": 37, "duration": 4}, {"beat": 212, "note": 37, "duration": 4}, {"beat": 216, "note": 39, "duration": 4}, {"beat": 220, "note": 39, "duration": 4}, {"beat": 224, "note": 37, "duration": 4}, {"beat": 228, "note": 37, "duration": 4}, {"beat": 232, "note": 39, "duration": 4}, {"beat": 236, "note": 39, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 89, "duration": 4}, {"beat": 96, "note": 89, "duration": 4}, {"beat": 176, "note": 89, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 18, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "This world is crazy, full of crazies,"}, {"beat": 44, "text": "Everyone gets offended, it's no longer soft,"}, {"beat": 52, "text": "A misplaced word, a joke in the air,"}, {"beat": 60, "text": "And people start shouting."}, {"beat": 68, "text": "Offended, not offended, we don't know what to think anymore,"}, {"beat": 76, "text": "Everyone finds a reason to get upset,"}, {"beat": 84, "text": "But I say, let's stop getting angry,"}, {"beat": 92, "text": "Let's live life without getting worked up."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "We walk on eggshells, we pay attention,"}, {"beat": 124, "text": "To every word, to every expression,"}, {"beat": 132, "text": "But I propose another solution,"}, {"beat": 140, "text": "Laugh at everything, without reservation."}, {"beat": 148, "text": "Offended, not offended, we don't know what to think anymore,"}, {"beat": 156, "text": "Everyone finds a reason to get upset,"}, {"beat": 164, "text": "But I say, let's stop getting angry,"}, {"beat": 172, "text": "Let's live life without getting worked up."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Because after all, we're all different,"}, {"beat": 220, "text": "With sensitivities on edge, it's crazy,"}, {"beat": 228, "text": "But life is too short to bicker,"}, {"beat": 236, "text": "Let's be free to laugh, to have fun."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}