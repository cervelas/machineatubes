 "duration": 4}, {"beat": 212, "note": 24, "duration": 4}, {"beat": 216, "note": 28, "duration": 4}, {"beat": 220, "note": 26, "duration": 4}, {"beat": 224, "note": 26, "duration": 4}, {"beat": 228, "note": 24, "duration": 4}, {"beat": 232, "note": 28, "duration": 4}, {"beat": 236, "note": 26, "duration": 4}]}, "toplines": {"type": "notes", "channel": 11, "notes": [{"beat": 16, "note": 51, "duration": 4}, {"beat": 96, "note": 51, "duration": 4}, {"beat": 176, "note": 51, "duration": 4}]}, "voix": {"type": "notes", "channel": 14, "notes": [{"beat": 0, "note": 2, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "I tried the piano, but it sounds so strange,"}, {"beat": 44, "text": "The guitar\u2019s not better, it hurts my fingers, quite deranged."}, {"beat": 52, "text": "Drums? No thanks, they take up too much space,"}, {"beat": 60, "text": "Musical instruments just aren\u2019t my taste."}, {"beat": 68, "text": "No instrument captures my interest fully,"}, {"beat": 76, "text": "I\u2019d rather sing, let the wind carry me truly."}, {"beat": 84, "text": "No need for notes, I make my voice ring,"}, {"beat": 92, "text": "And I promise you, it sounds pretty good, I sing!"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "I tried the flute, but I made a mess,"}, {"beat": 124, "text": "The saxophone was worse, it scared the whole neighborhood, I confess."}, {"beat": 132, "text": "The trumpet was a disaster, it frightens the animals too,"}, {"beat": 140, "text": "Musical instruments, I leave them to others, it\u2019s more fun to do."}, {"beat": 148, "text": "No instrument captures my interest fully,"}, {"beat": 156, "text": "I\u2019d rather sing, let the wind carry me truly."}, {"beat": 164, "text": "No need for notes, I make my voice ring,"}, {"beat": 172, "text": "And I promise you, it sounds pretty good, I sing!"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Some might say I lack the skill,"}, {"beat": 220, "text": "That I should practice, refine, and fulfill."}, {"beat": 228, "text": "But I reply with a cheeky grin,"}, {"beat": 236, "text": "Music is a joy that\u2019s childlike within."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}