, {"beat": 208, "note": 15, "duration": 4}, {"beat": 212, "note": 15, "duration": 4}, {"beat": 216, "note": 16, "duration": 4}, {"beat": 220, "note": 16, "duration": 4}, {"beat": 224, "note": 15, "duration": 4}, {"beat": 228, "note": 15, "duration": 4}, {"beat": 232, "note": 16, "duration": 4}, {"beat": 236, "note": 16, "duration": 4}]}, "toplines": {"type": "notes", "channel": 9, "notes": [{"beat": 16, "note": 97, "duration": 4}, {"beat": 96, "note": 97, "duration": 4}, {"beat": 176, "note": 97, "duration": 4}]}, "voix": {"type": "notes", "channel": 12, "notes": [{"beat": 0, "note": 72, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Dans l'ombre de l'informatique, une \u00e9nigme persiste,"}, {"beat": 44, "text": "Une pens\u00e9e qui se meut, une m\u00e9lancolie qui r\u00e9siste."}, {"beat": 52, "text": "L'\u00e9chapp\u00e9e d'une r\u00e9alit\u00e9 purement num\u00e9rique,"}, {"beat": 60, "text": "Une tristesse floue, une \u00e9motion \u00e9nigmatique."}, {"beat": 68, "text": "L'\u00c9nigme de l'Informatique, une tristesse voil\u00e9e,"}, {"beat": 76, "text": "Une pens\u00e9e qui s'\u00e9vade, dans l'horizon d\u00e9laiss\u00e9e."}, {"beat": 84, "text": "Entre v\u00e9rit\u00e9 et illusion, une fronti\u00e8re s'\u00e9chappe,"}, {"beat": 92, "text": "Une autre force insaisissable, qui nos vies attrape."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Nous errons dans les circuits, perdus dans l'abysse,"}, {"beat": 124, "text": "Des doutes envahissent, une tristesse qui persiste."}, {"beat": 132, "text": "Nous cherchons des r\u00e9ponses, un sens qui se d\u00e9robe,"}, {"beat": 140, "text": "L'informatique m\u00e9lancolique, une \u00e9nigme qui corrode."}, {"beat": 148, "text": "L'\u00c9nigme de l'Informatique, une tristesse voil\u00e9e,"}, {"beat": 156, "text": "Une pens\u00e9e qui s'\u00e9vade, dans l'horizon d\u00e9laiss\u00e9e."}, {"beat": 164, "text": "Entre v\u00e9rit\u00e9 et illusion, une fronti\u00e8re s'\u00e9chappe,"}, {"beat": 172, "text": "Une autre force insaisissable, qui nos vies attrape."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Les pixels refl\u00e8tent nos larmes invisibles,"}, {"beat": 220, "text": "L'informatique murmure des souvenirs indicibles."}, {"beat": 228, "text": "Une symphonie triste, dans les c\u00e2bles silencieux,"}, {"beat": 236, "text": "L'\u00e9nigme de l'informatique, une m\u00e9lancolie sans issue."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}