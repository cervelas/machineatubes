}, {"beat": 172, "text": "Observons-les tous, c'est ma chanson"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors venez avec moi, ouvrez les yeux"}, {"beat": 220, "text": "Observons ensemble, c'est ce que je veux"}, {"beat": 228, "text": "Dans ce monde si fou, trouvons des raisons"}, {"beat": 236, "text": "De rire et de chanter, en observant les gens."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}