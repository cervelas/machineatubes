ration": 4}, {"beat": 212, "note": 41, "duration": 4}, {"beat": 216, "note": 36, "duration": 4}, {"beat": 220, "note": 36, "duration": 4}, {"beat": 224, "note": 41, "duration": 4}, {"beat": 228, "note": 41, "duration": 4}, {"beat": 232, "note": 36, "duration": 4}, {"beat": 236, "note": 36, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 98, "duration": 4}, {"beat": 96, "note": 98, "duration": 4}, {"beat": 176, "note": 98, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 43, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Dans les mus\u00e9es snobinards, je me sens mal \u00e0 l'aise"}, {"beat": 44, "text": "Avec ma folie cr\u00e9atrice, je vais coiffer leurs vanit\u00e9s"}, {"beat": 52, "text": "Pas besoin d'un Picasso pour savoir appr\u00e9cier"}, {"beat": 60, "text": "Le vrai g\u00e9nie se trouve dans la simplicit\u00e9"}, {"beat": 68, "text": "J'aime l'art accessible, sans prise de t\u00eate"}, {"beat": 76, "text": "Un peu de couleur, un air qui nous guette"}, {"beat": 84, "text": "Les artistes talentueux, ceux qui nous font danser"}, {"beat": 92, "text": "L'art \u00e0 la folie, c'est tout ce qu'il me faut penser"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Je suis un franc d\u00e9lire, un clown sans \u00e9gal"}, {"beat": 124, "text": "Mes toiles color\u00e9es ont un air carnavalesque"}, {"beat": 132, "text": "Je griffonne des vers, des mots plein d'humour"}, {"beat": 140, "text": "Pour tous ceux qui veulent s'\u00e9chapper sans d\u00e9tour"}, {"beat": 148, "text": "J'aime l'art accessible, l\u00e9ger comme une plume"}, {"beat": 156, "text": "Quand \u00e7a parle \u00e0 tous et que \u00e7a nous consume"}, {"beat": 164, "text": "Les rimes rigolotes, les chansons qui font marrer"}, {"beat": 172, "text": "L'art \u00e0 la folie, c'est ce qui me fait vibrer"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Laissez l'art vous emporter, sans prise de t\u00eate ni confusion"}, {"beat": 220, "text": "Riez, dansez, ressentez cette passion"}, {"beat": 228, "text": "Car l'art accessible est un v\u00e9ritable tr\u00e9sor"}, {"beat": 236, "text": "Qui nous fait rire et vibrer encore et encore"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}