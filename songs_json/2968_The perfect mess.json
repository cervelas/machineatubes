 220, "note": 36, "duration": 4}, {"beat": 224, "note": 40, "duration": 4}, {"beat": 228, "note": 38, "duration": 4}, {"beat": 232, "note": 41, "duration": 4}, {"beat": 236, "note": 36, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 23, "duration": 4}, {"beat": 96, "note": 23, "duration": 4}, {"beat": 176, "note": 23, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 101, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "My closet's a total mess,"}, {"beat": 44, "text": "With socks and leftovers, no less,"}, {"beat": 52, "text": "But I always find my clothes,"}, {"beat": 60, "text": "In this chaos that makes people pose."}, {"beat": 68, "text": "I'm messy, that\u2019s no secret,"}, {"beat": 76, "text": "In my world, order\u2019s not perfect,"}, {"beat": 84, "text": "I mix it all, I\u2019m quite the nut,"}, {"beat": 92, "text": "Disorder is my daily rut."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "In my kitchen, pots pile high,"}, {"beat": 124, "text": "But I whip up recipes that never lie,"}, {"beat": 132, "text": "Mixed flavors burst with delight,"}, {"beat": 140, "text": "And my friends love it, what a sight."}, {"beat": 148, "text": "I\u2019m a perfectionist, wanting it right,"}, {"beat": 156, "text": "But I\u2019m messy, it\u2019s my way of life,"}, {"beat": 164, "text": "I muddle things up, it makes me laugh,"}, {"beat": 172, "text": "An artist of chaos, that\u2019s my craft."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "So if you\u2019re messy and a bit of a perfectionist too,"}, {"beat": 220, "text": "Come dance with me, in this optimistic view,"}, {"beat": 228, "text": "For disorder and order can coexist,"}, {"beat": 236, "text": "In a world where madness reigns, come and enlist!"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}