 40, "duration": 4}, {"beat": 172, "note": 40, "duration": 4}, {"beat": 208, "note": 39, "duration": 4}, {"beat": 212, "note": 39, "duration": 4}, {"beat": 216, "note": 40, "duration": 4}, {"beat": 220, "note": 40, "duration": 4}, {"beat": 224, "note": 39, "duration": 4}, {"beat": 228, "note": 39, "duration": 4}, {"beat": 232, "note": 40, "duration": 4}, {"beat": 236, "note": 40, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 37, "duration": 4}, {"beat": 96, "note": 37, "duration": 4}, {"beat": 176, "note": 37, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 44, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Dans un mus\u00e9e ou sur un mur de rue,"}, {"beat": 44, "text": "L'art s'exprime, c'est la f\u00eate continue,"}, {"beat": 52, "text": "Des sculptures folles aux couleurs \u00e9clatantes,"}, {"beat": 60, "text": "On se laisse emporter, l'\u00e9motion est vibrante."}, {"beat": 68, "text": "J'aime l'art accessible, c'est une merveille,"}, {"beat": 76, "text": "Une touche de couleur qui \u00e9veille,"}, {"beat": 84, "text": "Les sourires et les rires, c'est g\u00e9nial,"}, {"beat": 92, "text": "L'art, c'est pour tous, c'est vraiment sp\u00e9cial."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Un petit clown sur une toile amusante,"}, {"beat": 124, "text": "Un tableau qui nous fait tourner la t\u00eate,"}, {"beat": 132, "text": "L'art nous fait r\u00eaver, \u00e7a nous d\u00e9livre,"}, {"beat": 140, "text": "Des \u00e9motions magiques qui nous font sourire."}, {"beat": 148, "text": "J'aime l'art accessible, quel bonheur,"}, {"beat": 156, "text": "Il n'y a pas de r\u00e8gle, pas de censure,"}, {"beat": 164, "text": "Des pinceaux qui dansent, des toiles qui parlent,"}, {"beat": 172, "text": "L'art nous rassemble, c'est la meilleure \u00e9tincelle."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "J'aime l'art accessible, c'est une merveille,"}, {"beat": 220, "text": "Une touche de couleur qui \u00e9veille,"}, {"beat": 228, "text": "Les sourires et les rires, c'est g\u00e9nial,"}, {"beat": 236, "text": "L'art, c'est pour tous, c'est vraiment sp\u00e9cial."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}