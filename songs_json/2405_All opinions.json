"note": 39, "duration": 4}, {"beat": 164, "note": 39, "duration": 4}, {"beat": 168, "note": 40, "duration": 4}, {"beat": 172, "note": 40, "duration": 4}, {"beat": 208, "note": 39, "duration": 4}, {"beat": 212, "note": 39, "duration": 4}, {"beat": 216, "note": 40, "duration": 4}, {"beat": 220, "note": 40, "duration": 4}, {"beat": 224, "note": 39, "duration": 4}, {"beat": 228, "note": 39, "duration": 4}, {"beat": 232, "note": 40, "duration": 4}, {"beat": 236, "note": 40, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 91, "duration": 4}, {"beat": 96, "note": 91, "duration": 4}, {"beat": 176, "note": 91, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 81, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "On social media, it's a battleground of hate,"}, {"beat": 44, "text": "Everyone has their say, even stones take the stage."}, {"beat": 52, "text": "But I\u2019d rather make hearts dance,"}, {"beat": 60, "text": "On light notes, forgetting all the mischance."}, {"beat": 68, "text": "All the opinions, all the opinions, they can drive you mad,"}, {"beat": 76, "text": "We love to grumble, criticize, it's the chaos we\u2019ve had."}, {"beat": 84, "text": "But I say, I say, peace and love for all,"}, {"beat": 92, "text": "Let\u2019s tolerate and celebrate, it\u2019s so much more cool."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "I\u2019ve got friends telling me what to think,"}, {"beat": 124, "text": "But in my head, I\u2019d rather let it all sink."}, {"beat": 132, "text": "The world\u2019s much brighter when we\u2019re free,"}, {"beat": 140, "text": "From judgment\u2019s chains, we can be truly carefree."}, {"beat": 148, "text": "All the opinions, all the opinions, they don't matter much,"}, {"beat": 156, "text": "My radiant smile leaves them out of touch."}, {"beat": 164, "text": "You can\u2019t please everyone, that\u2019s well-known,"}, {"beat": 172, "text": "So let\u2019s dance, let\u2019s sing, and be proud of our own."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "All the opinions, all the opinions, it\u2019s so much fun,"}, {"beat": 220, "text": "I\u2019m me, you\u2019re you, we\u2019re different, we\u2019ve won."}, {"beat": 228, "text": "In diversity, there\u2019s so much to share,"}, {"beat": 236, "text": "Let\u2019s dance together, laugh together, enjoy the freedom we bear."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}