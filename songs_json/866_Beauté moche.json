}, {"beat": 212, "note": 24, "duration": 4}, {"beat": 216, "note": 26, "duration": 4}, {"beat": 220, "note": 25, "duration": 4}, {"beat": 224, "note": 27, "duration": 4}, {"beat": 228, "note": 24, "duration": 4}, {"beat": 232, "note": 26, "duration": 4}, {"beat": 236, "note": 25, "duration": 4}]}, "toplines": {"type": "notes", "channel": 11, "notes": [{"beat": 16, "note": 51, "duration": 4}, {"beat": 96, "note": 51, "duration": 4}, {"beat": 176, "note": 51, "duration": 4}]}, "voix": {"type": "notes", "channel": 14, "notes": [{"beat": 0, "note": 19, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "J'ai d\u00e9couvert une chose incroyable,"}, {"beat": 44, "text": "Des trucs moches qui deviennent m\u00e9morables,"}, {"beat": 52, "text": "Je peux te dire, c'est assez \u00e9tonnant,"}, {"beat": 60, "text": "Comment le laid peut \u00eatre fascinant."}, {"beat": 68, "text": "Le moche devient cool, le laid devient la mode,"}, {"beat": 76, "text": "Les imperfections sont \u00e0 la gloire,"}, {"beat": 84, "text": "Dans ce monde fou, on trouve de l'audace,"}, {"beat": 92, "text": "C'est \u00e7a qui rend la vie plus amusante."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "J'ai pris une vieille chaussette trou\u00e9e,"}, {"beat": 124, "text": "Et j'en ai fait un accessoire branch\u00e9,"}, {"beat": 132, "text": "Tout le monde me demande o\u00f9 je l'ai eu,"}, {"beat": 140, "text": "C'est dans mon placard, tout est bienvenu!"}, {"beat": 148, "text": "Le moche devient cool, le laid devient la mode,"}, {"beat": 156, "text": "Les imperfections sont \u00e0 la gloire,"}, {"beat": 164, "text": "Dans ce monde fou, on trouve de l'audace,"}, {"beat": 172, "text": "C'est \u00e7a qui rend la vie plus amusante."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Alors chante avec moi cette m\u00e9lodie funky,"}, {"beat": 220, "text": "Oublions les r\u00e8gles, soyons tous un peu funky,"}, {"beat": 228, "text": "Le moche devient cool, ouais c'est la v\u00e9rit\u00e9,"}, {"beat": 236, "text": "Dans cette chanson d\u00e9cal\u00e9e, on trouve sa beaut\u00e9."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}