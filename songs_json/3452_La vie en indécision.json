n": 4}, {"beat": 216, "note": 15, "duration": 4}, {"beat": 220, "note": 15, "duration": 4}, {"beat": 224, "note": 17, "duration": 4}, {"beat": 228, "note": 12, "duration": 4}, {"beat": 232, "note": 15, "duration": 4}, {"beat": 236, "note": 15, "duration": 4}]}, "toplines": {"type": "notes", "channel": 9, "notes": [{"beat": 16, "note": 89, "duration": 4}, {"beat": 96, "note": 89, "duration": 4}, {"beat": 176, "note": 89, "duration": 4}]}, "voix": {"type": "notes", "channel": 12, "notes": [{"beat": 0, "note": 55, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Dans ma t\u00eate, c'est toujours le flou"}, {"beat": 44, "text": "Je fais le grand saut, mais j'en perds le go\u00fbt"}, {"beat": 52, "text": "Entre le oui et le non, c'est l'ind\u00e9cision"}, {"beat": 60, "text": "J'avance \u00e0 t\u00e2tons, dans cette confusion"}, {"beat": 68, "text": "C'est compliqu\u00e9, j'suis d\u00e9sol\u00e9"}, {"beat": 76, "text": "Parfois j'suis paum\u00e9, j'ai pas d'avis"}, {"beat": 84, "text": "La vie, c'est comme \u00e7a, j'ai pas choisi"}, {"beat": 92, "text": "Je danse au gr\u00e9 de mes h\u00e9sitations"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Les choix sont nombreux, mais je suis coinc\u00e9"}, {"beat": 124, "text": "Je change d'avis chaque fois que je suis interrog\u00e9"}, {"beat": 132, "text": "J'essaie de comprendre, de trouver ma voie"}, {"beat": 140, "text": "Mais j'suis perdu, comme un poisson dans l'eau"}, {"beat": 148, "text": "C'est compliqu\u00e9, j'suis d\u00e9sol\u00e9"}, {"beat": 156, "text": "Parfois j'suis paum\u00e9, j'ai pas d'avis"}, {"beat": 164, "text": "La vie, c'est comme \u00e7a, j'ai pas choisi"}, {"beat": 172, "text": "Je danse au gr\u00e9 de mes h\u00e9sitations"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Et voil\u00e0, mes amis, c'est \u00e7a, la vie en ind\u00e9cision"}, {"beat": 220, "text": "On ne peut jamais \u00eatre s\u00fbr de rien, n'est-ce pas ?"}, {"beat": 228, "text": "Allez, on danse !"}, {"beat": 236, "text": "La vie est trop courte pour se prendre trop au s\u00e9rieux."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}