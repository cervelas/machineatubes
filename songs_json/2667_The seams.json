": "[ solo ]"}, {"beat": 212, "text": "We tinker, we assemble, we create with pride,"}, {"beat": 220, "text": "In our creations, our hearts reside."}, {"beat": 228, "text": "The little flaws, that\u2019s what makes them shine,"}, {"beat": 236, "text": "It\u2019s what sets us apart, our unique sign."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}