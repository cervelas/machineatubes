 168, "note": 41, "duration": 4}, {"beat": 172, "note": 41, "duration": 4}, {"beat": 208, "note": 40, "duration": 4}, {"beat": 212, "note": 40, "duration": 4}, {"beat": 216, "note": 41, "duration": 4}, {"beat": 220, "note": 41, "duration": 4}, {"beat": 224, "note": 40, "duration": 4}, {"beat": 228, "note": 40, "duration": 4}, {"beat": 232, "note": 41, "duration": 4}, {"beat": 236, "note": 41, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 37, "duration": 4}, {"beat": 96, "note": 37, "duration": 4}, {"beat": 176, "note": 37, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 108, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Marre du quotidien, tout est gris,"}, {"beat": 44, "text": "Besoin d'un peu de folie, de magie."}, {"beat": 52, "text": "Je vais me lancer, sans m'arr\u00eater,"}, {"beat": 60, "text": "Vers un futur plein de l\u00e9g\u00e8ret\u00e9."}, {"beat": 68, "text": "J'ai envie de changer ma vie,"}, {"beat": 76, "text": "D'explorer de nouveaux paradis."}, {"beat": 84, "text": "Une nouvelle, c'est \u00e7a qu'il me faut,"}, {"beat": 92, "text": "Jeter mes soucis \u00e0 l'eau!"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "Je veux voir le monde en technicolor,"}, {"beat": 124, "text": "Rire sans raison, \u00e0 en perdre le nord."}, {"beat": 132, "text": "Adieu les soucis, bonjour la libert\u00e9,"}, {"beat": 140, "text": "Je m'\u00e9vade de la monotonie affol\u00e9e."}, {"beat": 148, "text": "Je vais danser sur mes probl\u00e8mes,"}, {"beat": 156, "text": "Faire la f\u00eate, oublier le syst\u00e8me."}, {"beat": 164, "text": "Une nouvelle, tout simplement,"}, {"beat": 172, "text": "Vivre ma vie, compl\u00e8tement."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Je serai le Ma\u00eetre du rire,"}, {"beat": 220, "text": "Sur sc\u00e8ne, je brillerai et je m'\u00e9manciperai."}, {"beat": 228, "text": "Avec ma voix, je ferai vibrer,"}, {"beat": 236, "text": "Le monde entier, dans la gaiet\u00e9."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}