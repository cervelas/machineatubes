tion": 4}, {"beat": 212, "note": 41, "duration": 4}, {"beat": 216, "note": 39, "duration": 4}, {"beat": 220, "note": 40, "duration": 4}, {"beat": 224, "note": 37, "duration": 4}, {"beat": 228, "note": 41, "duration": 4}, {"beat": 232, "note": 39, "duration": 4}, {"beat": 236, "note": 40, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 22, "duration": 4}, {"beat": 96, "note": 22, "duration": 4}, {"beat": 176, "note": 22, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 69, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "Le matin, je me l\u00e8ve, tout para\u00eet bien rang\u00e9"}, {"beat": 44, "text": "Mais tr\u00e8s vite, l'envie me pousse \u00e0 tout bousculer"}, {"beat": 52, "text": "Je mets mes chaussettes avec mes souliers"}, {"beat": 60, "text": "Les r\u00e8gles du quotidien, j'aime les contourner"}, {"beat": 68, "text": "Dans ma vie bien rang\u00e9e, tout est bien ordonn\u00e9"}, {"beat": 76, "text": "Mais je ne peux m'emp\u00eacher de tout chambouler"}, {"beat": 84, "text": "Je vois pas l'int\u00e9r\u00eat de rester bien carr\u00e9"}, {"beat": 92, "text": "Alors vive le bordel, laissez-moi m'\u00e9clater!"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "\u00c0 la maison, les meubles, tous bien align\u00e9s"}, {"beat": 124, "text": "Mais je pr\u00e9f\u00e8re les d\u00e9placer, les d\u00e9sorganiser"}, {"beat": 132, "text": "Un peu de chaos, \u00e7a fait du bien \u00e0 mon esprit"}, {"beat": 140, "text": "Laissons les choses vivre et danser dans l'oubli"}, {"beat": 148, "text": "Dans ma vie bien rang\u00e9e, tout est bien ordonn\u00e9"}, {"beat": 156, "text": "Mais je ne peux m'emp\u00eacher de tout chambouler"}, {"beat": 164, "text": "Je vois pas l'int\u00e9r\u00eat de rester bien carr\u00e9"}, {"beat": 172, "text": "Alors vive le bordel, laissez-moi m'\u00e9clater!"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Laissez-moi vivre ma vie, pleine de d\u00e9sordre et folie"}, {"beat": 220, "text": "Le chaos me donne de l'\u00e9nergie, j'en tire ma m\u00e9lodie"}, {"beat": 228, "text": "Je vois pas l'int\u00e9r\u00eat de me plier \u00e0 ces conventions"}, {"beat": 236, "text": "Alors vive le bordel, j'en fais ma r\u00e9bellion!"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}