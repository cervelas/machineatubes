 4}, {"beat": 164, "note": 24, "duration": 4}, {"beat": 168, "note": 29, "duration": 4}, {"beat": 172, "note": 29, "duration": 4}, {"beat": 208, "note": 24, "duration": 4}, {"beat": 212, "note": 24, "duration": 4}, {"beat": 216, "note": 29, "duration": 4}, {"beat": 220, "note": 29, "duration": 4}, {"beat": 224, "note": 24, "duration": 4}, {"beat": 228, "note": 24, "duration": 4}, {"beat": 232, "note": 29, "duration": 4}, {"beat": 236, "note": 29, "duration": 4}]}, "toplines": {"type": "notes", "channel": 11, "notes": [{"beat": 16, "note": 3, "duration": 4}, {"beat": 96, "note": 3, "duration": 4}, {"beat": 176, "note": 3, "duration": 4}]}, "voix": {"type": "notes", "channel": 14, "notes": [{"beat": 0, "note": 52, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "I don\u2019t have time for the haters, their insults make me laugh,"}, {"beat": 44, "text": "I\u2019d rather keep on smiling, and let them wallow in the rough."}, {"beat": 52, "text": "Haters may despise, but I don\u2019t care at all,"}, {"beat": 60, "text": "I\u2019m a magnet for good vibes, it makes me stand tall."}, {"beat": 68, "text": "When I wake up in the morning, there\u2019s always sunshine,"}, {"beat": 76, "text": "Negative comments fade, left behind in my mind."}, {"beat": 84, "text": "Life is too short, we\u2019ve got to make it shine,"}, {"beat": 92, "text": "Let\u2019s embrace positivity, and all feel fine."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "In my life, everything\u2019s great, even when it's not right,"}, {"beat": 124, "text": "I always find the funny side, and it makes things light."}, {"beat": 132, "text": "Small problems mean nothing, I give them no weight,"}, {"beat": 140, "text": "I prefer to laugh it off, that\u2019s my best trait."}, {"beat": 148, "text": "On social media, the negatives are high,"}, {"beat": 156, "text": "But I just ignore them, they don\u2019t make me sigh."}, {"beat": 164, "text": "I don\u2019t need their critiques, they slide off like water,"}, {"beat": 172, "text": "Long live positivity, it\u2019s my joy\u2019s main fodder."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "So let\u2019s all sing together, loud and clear,"}, {"beat": 220, "text": "Life is beautiful, let\u2019s make it a cheer."}, {"beat": 228, "text": "Negative comments, we\u2019ll leave them behind,"}, {"beat": 236, "text": "Long live positivity, it\u2019s the gift we\u2019ll find."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}