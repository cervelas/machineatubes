t": "[ solo ]"}, {"beat": 212, "text": "So come with me, open your eyes"}, {"beat": 220, "text": "Let\u2019s observe together, under the skies"}, {"beat": 228, "text": "In this crazy world, let\u2019s find the reason"}, {"beat": 236, "text": "To laugh and to sing, observing the season"}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}