ion": 4}, {"beat": 160, "note": 25, "duration": 4}, {"beat": 164, "note": 27, "duration": 4}, {"beat": 168, "note": 26, "duration": 4}, {"beat": 172, "note": 28, "duration": 4}, {"beat": 208, "note": 25, "duration": 4}, {"beat": 212, "note": 27, "duration": 4}, {"beat": 216, "note": 26, "duration": 4}, {"beat": 220, "note": 28, "duration": 4}, {"beat": 224, "note": 25, "duration": 4}, {"beat": 228, "note": 27, "duration": 4}, {"beat": 232, "note": 26, "duration": 4}, {"beat": 236, "note": 28, "duration": 4}]}, "toplines": {"type": "notes", "channel": 11, "notes": [{"beat": 16, "note": 99, "duration": 4}, {"beat": 96, "note": 99, "duration": 4}, {"beat": 176, "note": 99, "duration": 4}]}, "voix": {"type": "notes", "channel": 14, "notes": [{"beat": 0, "note": 2, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "J'ai essay\u00e9 le piano, mais \u00e7a sonne bizarre,"}, {"beat": 44, "text": "La guitare c'est pas mieux, \u00e7a fait mal aux phalanges."}, {"beat": 52, "text": "La batterie ? Non merci, \u00e7a me prend trop de place,"}, {"beat": 60, "text": "Les instruments de musique, c'est pas ma tasse de th\u00e9."}, {"beat": 68, "text": "Aucun instrument ne m'int\u00e9resse compl\u00e8tement,"}, {"beat": 76, "text": "Je pr\u00e9f\u00e8re chanter, me laisser porter par le vent."}, {"beat": 84, "text": "Pas besoin de notes, je fais vibrer ma voix,"}, {"beat": 92, "text": "Et je te promets, \u00e7a sonne plut\u00f4t pas mal, ma foi !"}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "J'ai tent\u00e9 la fl\u00fbte, mais j'ai tout bousill\u00e9,"}, {"beat": 124, "text": "Le saxophone, c'\u00e9tait pire, j'ai fait fuir tout le quartier."}, {"beat": 132, "text": "La trompette, c'\u00e9tait la catastrophe, \u00e7a fait peur aux animaux,"}, {"beat": 140, "text": "Les instruments de musique, je les laisse aux autres, c'est plus marrant comme \u00e7a."}, {"beat": 148, "text": "Aucun instrument ne m'int\u00e9resse compl\u00e8tement,"}, {"beat": 156, "text": "Je pr\u00e9f\u00e8re chanter, me laisser porter par le vent."}, {"beat": 164, "text": "Pas besoin de notes, je fais vibrer ma voix,"}, {"beat": 172, "text": "Et je te promets, \u00e7a sonne plut\u00f4t pas mal, ma foi !"}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "Certains diront que je suis pas dou\u00e9,"}, {"beat": 220, "text": "Que je devrais m'entra\u00eener, me perfectionner."}, {"beat": 228, "text": "Mais je leur r\u00e9ponds, d'un air malin,"}, {"beat": 236, "text": "La musique, c'est avant tout un plaisir enfantin."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}