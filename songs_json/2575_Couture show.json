te": 39, "duration": 4}, {"beat": 164, "note": 36, "duration": 4}, {"beat": 168, "note": 38, "duration": 4}, {"beat": 172, "note": 39, "duration": 4}, {"beat": 208, "note": 39, "duration": 4}, {"beat": 212, "note": 36, "duration": 4}, {"beat": 216, "note": 38, "duration": 4}, {"beat": 220, "note": 39, "duration": 4}, {"beat": 224, "note": 39, "duration": 4}, {"beat": 228, "note": 36, "duration": 4}, {"beat": 232, "note": 38, "duration": 4}, {"beat": 236, "note": 39, "duration": 4}]}, "toplines": {"type": "notes", "channel": 10, "notes": [{"beat": 16, "note": 89, "duration": 4}, {"beat": 96, "note": 89, "duration": 4}, {"beat": 176, "note": 89, "duration": 4}]}, "voix": {"type": "notes", "channel": 13, "notes": [{"beat": 0, "note": 58, "duration": 4}]}, "lyrics": {"type": "lyrics", "lyrics": [{"beat": 0, "text": ""}, {"beat": 4, "text": "[intro]"}, {"beat": 36, "text": "When I wake up in the morning, I'm not super glam,"}, {"beat": 44, "text": "Sequins and makeup? Not my jam, ma\u2019am."}, {"beat": 52, "text": "But as soon as I show up, everyone\u2019s in awe,"}, {"beat": 60, "text": "And all I want to do is hide\u2014it's just a flaw."}, {"beat": 68, "text": "I\u2019m a pop star, the world adores,"}, {"beat": 76, "text": "But there\u2019s one thing that still makes me sore."}, {"beat": 84, "text": "People see me as too perfect, it\u2019s true,"}, {"beat": 92, "text": "But I\u2019m tired of the seams and what they construe."}, {"beat": 100, "text": "[ \u2026 ]"}, {"beat": 116, "text": "I\u2019m tired of smiling all the time for the cam,"}, {"beat": 124, "text": "My life\u2019s not all sparkles and glam."}, {"beat": 132, "text": "I want to be real, without masks or glitz,"}, {"beat": 140, "text": "The worth of a person isn\u2019t in their bits."}, {"beat": 148, "text": "It\u2019s the Couture Show, but I don\u2019t agree,"}, {"beat": 156, "text": "It\u2019s my flaws I want to show, let them be."}, {"beat": 164, "text": "I\u2019m not a doll; I\u2019m just me,"}, {"beat": 172, "text": "And if they see the seams, I\u2019m fine, I\u2019m free."}, {"beat": 180, "text": "[ solo ]"}, {"beat": 212, "text": "It\u2019s the Couture Show, but I don\u2019t agree,"}, {"beat": 220, "text": "It\u2019s my flaws I want to show, let them be."}, {"beat": 228, "text": "I\u2019m not a doll; I\u2019m just me,"}, {"beat": 236, "text": "And if they see the seams, I\u2019m fine, I\u2019m free."}, {"beat": 244, "text": "[outro]"}, {"beat": 252, "text": ""}]}}}